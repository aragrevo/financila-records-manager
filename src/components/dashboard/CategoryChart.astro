---
import Chip from '../ui/Chip.astro';

interface CategoryData {
  name: string;
  amount: number;
  percentage: number;
  color: 'emergency' | 'investment' | 'retirement' | 'contingency';
}

interface Props {
  categories: CategoryData[];
  class?: string;
}

const { categories, class: className = '' } = Astro.props;

const colorClasses = {
  emergency: 'bg-emergency',
  investment: 'bg-investment',
  retirement: 'bg-retirement',
  contingency: 'bg-contingency',
};

const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
};
---

<div class:list={['space-y-4', className]}>
  <h3 class="text-lg font-semibold text-on-surface">Asset Allocation</h3>
  
  <!-- Stacked bar chart -->
  <div class="h-4 rounded-full overflow-hidden flex">
    {categories.map((cat) => (
      <div
        class:list={[colorClasses[cat.color]]}
        style={`width: ${cat.percentage}%`}
        title={`${cat.name}: ${cat.percentage}%`}
      />
    ))}
  </div>
  
  <!-- Legend -->
  <div class="grid grid-cols-2 gap-3">
    {categories.map((cat) => (
      <div class="flex items-center space-x-2">
        <div class:list={['w-3 h-3 rounded-full', colorClasses[cat.color]]} />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-on-surface truncate">{cat.name}</p>
          <p class="text-xs text-on-surface-variant financial-figure">{formatCurrency(cat.amount)}</p>
        </div>
        <span class="text-xs font-medium text-on-surface-variant">{cat.percentage}%</span>
      </div>
    ))}
  </div>
</div>
