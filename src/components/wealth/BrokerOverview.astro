---
import Card from "../ui/Card.astro";
import Chip from "../ui/Chip.astro";
import { STOCK_BROKERS } from "../../lib/constants";
import { formatCurrency, formatPercentage } from "../../utils/format";
import type { BrokerChipVariant, BrokerSummaryItem } from "./types";

interface Props {
  brokerSummary: BrokerSummaryItem[];
  portfolioValue: number;
  accountsCount: number;
  positionsCount: number;
  assetTypesCount: number;
  brokerVariant: Record<keyof typeof STOCK_BROKERS, BrokerChipVariant>;
}

const {
  brokerSummary,
  portfolioValue,
  accountsCount,
  positionsCount,
  assetTypesCount,
  brokerVariant,
} = Astro.props;

const totalBrokerValue = brokerSummary.reduce(
  (sum, broker) => sum + broker.marketValue + broker.availableCash,
  0,
);
---

<section class="grid grid-cols-1 gap-6 xl:grid-cols-[1.6fr_1fr]">
  <Card class="space-y-4">
    <div>
      <h2 class="text-headline-md font-bold text-on-surface">
        Resumen por broker
      </h2>
      <p class="text-sm text-on-surface-variant">
        Concentración real del portafolio por plataforma
      </p>
    </div>

    {
      brokerSummary.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {brokerSummary.map((broker) => {
            const brokerValue = broker.marketValue + broker.availableCash;
            const brokerWeight =
              portfolioValue > 0 ? (brokerValue / portfolioValue) * 100 : 0;

            return (
              <div class="rounded-xl border border-outline-variant bg-surface-container-low p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-lg font-semibold text-on-surface">
                      {STOCK_BROKERS[broker.broker]}
                    </p>
                  </div>
                  <Chip variant={brokerVariant[broker.broker]}>
                    {formatPercentage(brokerWeight)}
                  </Chip>
                </div>
                <div class="mt-3 space-y-1">
                  <p class="font-mono text-xl font-semibold text-on-surface">
                    {formatCurrency(brokerValue)}
                  </p>
                  <div class="flex items-center justify-between gap-3 rounded-xl bg-surface px-2 py-1">
                    <span
                      class="material-symbols-outlined text-on-surface-variant"
                      title="Disponible"
                    >
                      payments
                    </span>
                    <p class="text-sm text-on-surface-variant mb-0">
                      {formatCurrency(broker.availableCash)}
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-3 rounded-xl bg-surface px-2 py-1">
                    <span
                      class="material-symbols-outlined text-on-surface-variant"
                      title="Invertido"
                    >
                      finance
                    </span>
                    <p class="text-sm text-on-surface-variant mb-0">
                      {formatCurrency(broker.investedCapital)}
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-3 rounded-xl bg-surface px-2 py-1">
                    {broker.gain >= 0 ? (
                      <span class="material-symbols-outlined text-sm text-retirement font-extrabold">
                        arrow_upward
                      </span>
                    ) : (
                      <span class="material-symbols-outlined text-sm text-error font-extrabold">
                        arrow_downward
                      </span>
                    )}
                    <p
                      class:list={[
                        "text-sm font-medium",
                        broker.gain >= 0 ? "text-retirement" : "text-error",
                      ]}
                    >
                      {broker.gain >= 0 ? "+" : ""}
                      {formatCurrency(broker.gain)}
                    </p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-low p-6 text-center">
          <p class="font-semibold text-on-surface">
            Aún no hay datos de brokers
          </p>
          <p class="mt-1 text-sm text-on-surface-variant">
            Crea tu primera cuenta y luego registra posiciones para empezar a
            consolidar el portafolio.
          </p>
        </div>
      )
    }
  </Card>

  <Card class="space-y-4">
    <div>
      <h2 class="text-headline-md font-bold text-on-surface">Estado actual</h2>
      <p class="text-sm text-on-surface-variant">
        Lectura rápida del tamaño y distribución del módulo
      </p>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <div class="rounded-2xl bg-surface-container-low p-4 text-center">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-contingency/10 text-contingency"
        >
          <span class="material-symbols-outlined">account_balance</span>
        </div>
        <p class="mt-3 text-2xl font-semibold text-on-surface">
          {accountsCount}
        </p>
        <p class="text-label-caps uppercase text-on-surface-variant">Cuentas</p>
      </div>
      <div class="rounded-2xl bg-surface-container-low p-4 text-center">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-investment/10 text-investment"
        >
          <span class="material-symbols-outlined">candlestick_chart</span>
        </div>
        <p class="mt-3 text-2xl font-semibold text-on-surface">
          {positionsCount}
        </p>
        <p class="text-label-caps uppercase text-on-surface-variant">
          Posiciones
        </p>
      </div>
      <div class="rounded-2xl bg-surface-container-low p-4 text-center">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-retirement/10 text-retirement"
        >
          <span class="material-symbols-outlined">donut_large</span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-on-surface">
          {assetTypesCount}
        </p>
        <p class="text-label-caps uppercase text-on-surface-variant">Tipos</p>
      </div>
    </div>

    <div class="rounded-2xl bg-surface-container-low p-4">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div>
          <p class="font-semibold text-on-surface">Distribucion por broker</p>
        </div>
        <span
          class="rounded-full bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wide text-on-surface-variant"
        >
          {brokerSummary.length} activos
        </span>
      </div>

      {
        brokerSummary.length > 0 ? (
          <div class="space-y-3">
            <div class="flex h-3 overflow-hidden rounded-full bg-surface">
              {brokerSummary.map((broker) => {
                const share =
                  totalBrokerValue > 0
                    ? ((broker.marketValue + broker.availableCash) /
                        totalBrokerValue) *
                      100
                    : 0;
                const barColor = {
                  contingency: "bg-contingency",
                  investment: "bg-investment",
                  retirement: "bg-retirement",
                }[brokerVariant[broker.broker]];

                return (
                  <div
                    class:list={["h-full", barColor]}
                    style={`width: ${share}%`}
                  />
                );
              })}
            </div>

            <div class="space-y-2">
              {brokerSummary.map((broker) => {
                const share =
                  totalBrokerValue > 0
                    ? ((broker.marketValue + broker.availableCash) /
                        totalBrokerValue) *
                      100
                    : 0;

                return (
                  <div class="flex items-center justify-between gap-3 rounded-xl bg-surface px-3 py-2">
                    <div class="flex items-center gap-3">
                      <span
                        class:list={[
                          "h-3 w-3 rounded-full",
                          brokerVariant[broker.broker] === "contingency"
                            ? "bg-contingency"
                            : brokerVariant[broker.broker] === "investment"
                              ? "bg-investment"
                              : "bg-retirement",
                        ]}
                      />
                      <div>
                        <p class="font-medium text-on-surface">
                          {STOCK_BROKERS[broker.broker]}
                        </p>
                        <p class="text-xs text-on-surface-variant">
                          {broker.accounts} cuentas · {broker.positions}{" "}
                          posiciones
                        </p>
                      </div>
                    </div>
                    <p class="font-mono text-sm font-semibold text-on-surface">
                      {formatPercentage(share)}
                    </p>
                  </div>
                );
              })}
            </div>
          </div>
        ) : (
          <p class="text-sm text-on-surface-variant">
            Cuando registres cuentas, aquí verás su reparto visual.
          </p>
        )
      }
    </div>
  </Card>
</section>
