---
import Card from "../ui/Card.astro";
import Chip from "../ui/Chip.astro";
import { STOCK_BROKERS } from "../../lib/constants";
import type { StockBroker } from "../../lib/constants";
import { formatCurrency, formatPercentage } from "../../utils/format";
import type {
  AssetTypeSummaryItem,
  BrokerChipVariant,
  RepeatedTickerSummaryItem,
} from "./types";

interface Props {
  assetTypeSummary: AssetTypeSummaryItem[];
  repeatedTickers: RepeatedTickerSummaryItem[];
  brokerVariant: Record<StockBroker, BrokerChipVariant>;
}

const { assetTypeSummary, repeatedTickers, brokerVariant } = Astro.props;

const colorClasses = {
  contingency: "bg-contingency",
  investment: "bg-investment",
  emergency: "bg-emergency",
  retirement: "bg-retirement",
} as const;

const strokeColors = {
  contingency: "var(--color-contingency)",
  investment: "var(--color-investment)",
  emergency: "var(--color-emergency)",
  retirement: "var(--color-retirement)",
} as const;

const tickerColorKeys = [
  "investment",
  "emergency",
  "retirement",
  "contingency",
] as const;

const tickerAvatarClasses = {
  investment: "bg-investment text-on-surface",
  emergency: "bg-emergency text-white",
  retirement: "bg-retirement text-white",
  contingency: "bg-contingency text-white",
} as const;

const donutRadius = 36;
const donutCircumference = 2 * Math.PI * donutRadius;
const totalValue = assetTypeSummary.reduce((sum, item) => sum + item.value, 0);

const donutSegments = assetTypeSummary.reduce<
  Array<
    AssetTypeSummaryItem & {
      dashArray: string;
      dashOffset: number;
      stroke: string;
    }
  >
>((segments, item) => {
  const previousLength = segments.reduce(
    (sum, segment) => sum + (parseFloat(segment.dashArray.split(" ")[0]) || 0),
    0,
  );
  const segmentLength = (item.percentage / 100) * donutCircumference;

  segments.push({
    ...item,
    dashArray: `${segmentLength} ${donutCircumference}`,
    dashOffset: -previousLength,
    stroke: strokeColors[item.color],
  });

  return segments;
}, []);
---

<section class="grid grid-cols-1 gap-6 xl:grid-cols-2">
  <Card class="space-y-4">
    <div>
      <h2 class="text-headline-md font-bold text-on-surface">
        Distribución por tipo
      </h2>
      <p class="text-sm text-on-surface-variant">
        Calculada con el valor actual de cada tipo de activo
      </p>
    </div>

    {
      assetTypeSummary.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-[280px_minmax(0,1fr)] md:items-center">
          <div class="flex justify-center">
            <div class="relative h-72 w-72">
              <svg
                viewBox="0 0 120 120"
                class="h-full w-full -rotate-90 drop-shadow-[0_8px_18px_rgba(25,28,30,0.08)]"
                aria-hidden="true"
              >
                <circle
                  cx="60"
                  cy="60"
                  r={donutRadius}
                  fill="none"
                  stroke="rgba(118, 119, 125, 0.14)"
                  stroke-width="18"
                />

                {donutSegments.map((segment) => (
                  <circle
                    cx="60"
                    cy="60"
                    r={donutRadius}
                    fill="none"
                    stroke={segment.stroke}
                    stroke-width="18"
                    stroke-linecap="round"
                    stroke-dasharray={segment.dashArray}
                    stroke-dashoffset={segment.dashOffset}
                  />
                ))}

                <circle
                  cx="60"
                  cy="60"
                  r="24"
                  fill="white"
                  stroke="rgba(198, 198, 205, 0.45)"
                  stroke-width="1.5"
                />
              </svg>

              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span class="text-label-caps uppercase text-on-surface-variant">
                  Total
                </span>
                <span class="mt-1 font-mono text-lg font-semibold text-on-surface">
                  {formatCurrency(totalValue)}
                </span>
                <span class="mt-2 text-[11px] font-semibold uppercase tracking-wide text-on-surface-variant">
                  {assetTypeSummary.length} tipos
                </span>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            {assetTypeSummary.map((item) => (
              <div class="flex items-center gap-3 rounded-lg bg-surface-container-low px-3 py-2.5">
                <div
                  class:list={[
                    "h-2.5 w-2.5 rounded-full shrink-0",
                    colorClasses[item.color],
                  ]}
                />
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-on-surface">
                    {item.label}
                  </p>
                  <p class="text-xs text-on-surface-variant">
                    {formatCurrency(item.value)}
                  </p>
                </div>
                <div class="text-right">
                  <p class="font-mono text-sm font-semibold text-on-surface">
                    {formatPercentage(item.percentage)}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="text-sm text-on-surface-variant">
          Aún no hay suficientes datos para mostrar la distribución por tipo.
        </p>
      )
    }
  </Card>

  <Card class="space-y-4">
    <div>
      <h2 class="text-headline-md font-bold text-on-surface">
        Tickers repetidos entre cuentas
      </h2>
      <p class="text-sm text-on-surface-variant">
        Concentración por ticker cuando lo tienes abierto en varias cuentas
      </p>
    </div>

    {
      repeatedTickers.length > 0 ? (
        <div class="grid gap-2 sm:grid-cols-2">
          {repeatedTickers.map((ticker, index) => (
            <div class="rounded-xl bg-surface-container-low p-3">
              <div class="flex items-center gap-3">
                <div
                  class:list={[
                    "flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-mono text-[11px] font-bold",
                    tickerAvatarClasses[
                      tickerColorKeys[index % tickerColorKeys.length]
                    ],
                  ]}
                >
                  {ticker.symbol.slice(0, 4)}
                </div>
                <div class="w-full flex flex-col gap-1">
                  <div class="flex items-center justify-between w-full">
                    <p class="min-w-0 flex-1 truncate text-sm font-medium text-on-surface">
                      {ticker.name}
                    </p>
                    <p class="font-mono text-sm font-semibold text-on-surface">
                      {formatCurrency(ticker.marketValue)}
                    </p>
                  </div>
                  <div class="mt-0 flex flex-wrap items-center gap-1.5">
                    {ticker.brokers.map((broker) => (
                      <Chip variant={brokerVariant[broker]} size="sm">
                        {STOCK_BROKERS[broker]}
                      </Chip>
                    ))}
                    <span class="text-xs text-on-surface-variant self-end ms-auto flex items-center gap-1">
                      {ticker.shares.toLocaleString("es-ES", {
                        maximumFractionDigits: 4,
                      })}
                      <span class="material-symbols-outlined text-on-surface-variant text-xs">
                        package_2
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl bg-surface-container-low p-4 text-sm text-on-surface-variant">
          No hay tickers activos repetidos en varias cuentas todavía.
        </div>
      )
    }
  </Card>
</section>
