---
import Chip from '../ui/Chip.astro';
import type { Transaction } from '../../data/transactions';

interface Props {
  transactions: Transaction[];
  class?: string;
}

const { transactions, class: className = '' } = Astro.props;

const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
};

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const getAmountClass = (type: Transaction['type']) => {
  switch (type) {
    case 'income':
      return 'positive-value';
    case 'expense':
      return 'negative-value';
    default:
      return '';
  }
};

const getCategoryChip = (category: string): { variant: 'emergency' | 'investment' | 'retirement' | 'contingency'; label: string } => {
  const categoryMap: Record<string, { variant: 'emergency' | 'investment' | 'retirement' | 'contingency'; label: string }> = {
    'Salary': { variant: 'retirement', label: 'Income' },
    'Freelance': { variant: 'retirement', label: 'Income' },
    'Investment Returns': { variant: 'investment', label: 'Investment' },
    'Food & Groceries': { variant: 'emergency', label: 'Essential' },
    'Utilities': { variant: 'emergency', label: 'Essential' },
    'Housing': { variant: 'emergency', label: 'Essential' },
    'Healthcare': { variant: 'emergency', label: 'Essential' },
    'Dining Out': { variant: 'contingency', label: 'Lifestyle' },
    'Entertainment': { variant: 'contingency', label: 'Lifestyle' },
    'Transportation': { variant: 'contingency', label: 'Transport' },
    'Savings Transfer': { variant: 'investment', label: 'Transfer' },
    'Stock Investment': { variant: 'investment', label: 'Investment' },
  };
  return categoryMap[category] || { variant: 'contingency', label: category };
};

const statusClasses = {
  completed: 'bg-retirement/10 text-retirement',
  pending: 'bg-investment/10 text-investment',
  cancelled: 'bg-error/10 text-error',
};
---

<div class:list={['overflow-x-auto', className]}>
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Description</th>
        <th>Category</th>
        <th>Account</th>
        <th>Status</th>
        <th class="text-right">Amount</th>
      </tr>
    </thead>
    <tbody>
      {transactions.map((txn) => {
        const chipInfo = getCategoryChip(txn.category);
        return (
          <tr>
            <td class="text-on-surface-variant whitespace-nowrap">
              {formatDate(txn.date)}
            </td>
            <td>
              <div class="font-medium text-on-surface">{txn.description}</div>
              {txn.merchant && (
                <div class="text-xs text-on-surface-variant mt-0.5">{txn.merchant}</div>
              )}
            </td>
            <td>
              <Chip variant={chipInfo.variant} size="sm">
                {chipInfo.label}
              </Chip>
            </td>
            <td class="text-on-surface-variant">{txn.account}</td>
            <td>
              <span class:list={['inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium', statusClasses[txn.status]]}>
                {txn.status}
              </span>
            </td>
            <td class:list={['text-right font-mono text-sm font-medium whitespace-nowrap', getAmountClass(txn.type)]}>
              {formatCurrency(txn.amount)}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
