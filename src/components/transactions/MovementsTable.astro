---
import { TRANSACTION_TYPES, ACCOUNT_CATEGORIES } from "../../lib/constants";
import { formatCurrencyCOP } from "../../utils/format";

interface Movement {
  date: string;
  account: string;
  description?: string;
  category: string;
  type: string;
  amount: string;
  isNegative?: boolean;
}

interface Props {
  movements: Movement[];
}

const { movements } = Astro.props;
const accounts = [...new Set(movements.map((movement) => movement.account))].sort();
const types = [...new Set(movements.map((movement) => movement.type))].sort();
const categories = [
  ...new Set(movements.map((movement) => movement.category)),
].sort();

const typeStyles: Record<string, string> = {
  income: "bg-emerald-100 text-emerald-800 border border-emerald-200",
  expense: "bg-red-100 text-red-800 border border-red-200",
  transfer: "bg-blue-100 text-blue-800 border border-blue-200",
  investment: "bg-amber-100 text-amber-800 border border-amber-200",
};

const categoryStyles: Record<string, string> = {
  emergency:
    "bg-error-container/30 text-error border border-error-container/50",
  investment: "bg-[#fcdeb5]/20 text-[#98805d] border border-[#fcdeb5]/30",
  retirement:
    "bg-secondary-container/30 text-secondary border border-secondary-container/50",
  contingency:
    "bg-primary-fixed/30 text-on-primary-fixed-variant border border-primary-fixed/50",
};
---

<div
  class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm"
>
  <div class="overflow-x-auto data-table-container">
    <table class="w-full text-left border-collapse">
      <thead
        class="sticky top-0 bg-surface-container-low z-10 border-b border-outline-variant"
      >
        <tr>
          <th
            class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant"
          >
            Fecha <span class="material-symbols-outlined text-xs align-middle"
              >arrow_downward</span
            >
          </th>
          <th class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant">
            <details class="relative inline-block text-left" data-movement-filter-menu>
              <summary class="flex cursor-pointer list-none items-center gap-1">
                <span>Cuenta</span>
                <span class="rounded-full bg-surface-container px-1.5 py-0.5 text-[10px] font-semibold text-on-surface-variant" data-movement-filter-count="account">0</span>
                <span class="material-symbols-outlined text-sm text-on-surface-variant">filter_list</span>
              </summary>
              <div class="absolute left-0 z-20 mt-2 w-52 rounded-xl border border-outline-variant bg-surface p-3 normal-case shadow-lg">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-on-surface-variant">Filtrar cuentas</p>
                <div class="space-y-2">
                  {accounts.map((account) => (
                    <label class="flex items-center gap-2 text-sm font-normal text-on-surface">
                      <input type="checkbox" value={account} class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary" data-movement-filter-option="account" />
                      <span>{account}</span>
                    </label>
                  ))}
                </div>
              </div>
            </details>
          </th>
          <th class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant">
            <details class="relative inline-block text-left" data-movement-filter-menu>
              <summary class="flex cursor-pointer list-none items-center gap-1">
                <span>Tipo</span>
                <span class="rounded-full bg-surface-container px-1.5 py-0.5 text-[10px] font-semibold text-on-surface-variant" data-movement-filter-count="type">0</span>
                <span class="material-symbols-outlined text-sm text-on-surface-variant">filter_list</span>
              </summary>
              <div class="absolute left-0 z-20 mt-2 w-52 rounded-xl border border-outline-variant bg-surface p-3 normal-case shadow-lg">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-on-surface-variant">Filtrar tipos</p>
                <div class="space-y-2">
                  {types.map((type) => (
                    <label class="flex items-center gap-2 text-sm font-normal text-on-surface">
                      <input type="checkbox" value={type} class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary" data-movement-filter-option="type" />
                      <span>{TRANSACTION_TYPES[type as keyof typeof TRANSACTION_TYPES] || type}</span>
                    </label>
                  ))}
                </div>
              </div>
            </details>
          </th>
          <th
            class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant"
            >Descripción</th
          >
          <th class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant">
            <details class="relative inline-block text-left" data-movement-filter-menu>
              <summary class="flex cursor-pointer list-none items-center gap-1">
                <span>Categoría</span>
                <span class="rounded-full bg-surface-container px-1.5 py-0.5 text-[10px] font-semibold text-on-surface-variant" data-movement-filter-count="category">0</span>
                <span class="material-symbols-outlined text-sm text-on-surface-variant">filter_list</span>
              </summary>
              <div class="absolute right-0 z-20 mt-2 w-52 rounded-xl border border-outline-variant bg-surface p-3 normal-case shadow-lg">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-on-surface-variant">Filtrar categorías</p>
                <div class="space-y-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm font-normal text-on-surface">
                      <input type="checkbox" value={category} class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary" data-movement-filter-option="category" />
                      <span>{ACCOUNT_CATEGORIES[category as keyof typeof ACCOUNT_CATEGORIES] || category}</span>
                    </label>
                  ))}
                </div>
              </div>
            </details>
          </th>
          <th
            class="px-6 py-4 text-label-caps font-label-caps text-on-surface-variant text-right"
            >Valor</th
          >
          <th class="px-2 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-outline-variant">
        {
          movements.map((mov) => (
            <tr
              class="movement-row hover:bg-surface-container transition-colors group"
              data-account={mov.account}
              data-type={mov.type}
              data-category={mov.category}
            >
              <td class="px-6 py-4 text-mono-data font-table-data">
                {mov.date}
              </td>
              <td class="px-6 py-4 text-table-data font-table-data">
                {mov.account}
              </td>
              <td class="px-6 py-4">
                <span
                  class:list={[
                    "px-2 py-1 text-[10px] font-bold uppercase rounded-full",
                    typeStyles[mov.type] ||
                      "bg-surface-container text-on-surface-variant",
                  ]}
                >
                  {TRANSACTION_TYPES[
                    mov.type as keyof typeof TRANSACTION_TYPES
                  ] || mov.type}
                </span>
              </td>
              <td class="px-6 py-4 text-table-data font-table-data text-on-surface">
                {mov.description || "N/A"}
              </td>
              <td class="px-6 py-4">
                <span
                  class:list={[
                    "px-2 py-1 text-[10px] font-bold uppercase rounded-full",
                    categoryStyles[mov.category] ||
                      "bg-surface-container text-on-surface-variant",
                  ]}
                >
                  {ACCOUNT_CATEGORIES[
                    mov.category as keyof typeof ACCOUNT_CATEGORIES
                  ] || mov.category}
                </span>
              </td>
              <td
                class:list={[
                  "px-6 py-4 text-right font-table-data text-table-data",
                  mov.isNegative ? "text-error font-bold" : "text-secondary",
                ]}
              >
                {formatCurrencyCOP(+mov.amount)}
              </td>
              <td class="px-2 py-4 opacity-0 group-hover:opacity-100 transition-opacity">
                <button class="material-symbols-outlined text-on-surface-variant hover:text-primary">
                  more_vert
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
