---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
  queryParam?: string;
}

const {
  currentPage,
  totalPages,
  basePath = Astro.url.pathname,
  queryParam = "page",
} = Astro.props;

const startPage = 1;
const endPage = totalPages;
const pages = Array.from(
  { length: Math.max(0, endPage - startPage + 1) },
  (_, i) => startPage + i,
);

const buildPageHref = (page: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);

  if (page <= 1) {
    params.delete(queryParam);
  } else {
    params.set(queryParam, String(page));
  }

  const query = params.toString();

  return query ? `${basePath}?${query}` : basePath;
};
---

<div
  class="border-t border-outline-variant px-6 py-3 bg-surface flex justify-between items-center"
>
  <div class="flex gap-2">
    <a
      href={buildPageHref(Math.max(1, currentPage - 1))}
      data-pagination-page={Math.max(1, currentPage - 1)}
      data-pagination-direction="previous"
      aria-disabled={currentPage <= 1}
      class:list={[
        "px-2 py-1 border border-outline-variant rounded-lg text-label-caps transition-colors",
        currentPage <= 1
          ? "pointer-events-none opacity-50"
          : "hover:bg-surface-container-high",
      ]}
    >
      <span class="material-symbols-outlined">chevron_left</span>
    </a>
    {
      pages.map((page) => (
        <a
          href={buildPageHref(page)}
          data-pagination-page={page}
          data-pagination-number
          aria-current={page === currentPage ? "page" : undefined}
          class:list={[
            "px-4 py-2 rounded-lg text-label-caps",
            page === currentPage
              ? "bg-primary text-on-primary"
              : "border border-outline-variant hover:bg-surface-container-high transition-colors",
          ]}
        >
          {page}
        </a>
      ))
    }
    <a
      href={buildPageHref(Math.min(totalPages, currentPage + 1))}
      data-pagination-page={Math.min(totalPages, currentPage + 1)}
      data-pagination-direction="next"
      aria-disabled={currentPage >= totalPages}
      class:list={[
        "p-1 border border-outline-variant rounded-lg text-label-caps transition-colors",
        currentPage >= totalPages
          ? "pointer-events-none opacity-50"
          : "hover:bg-surface-container-high",
      ]}
    >
      <span class="material-symbols-outlined">chevron_right</span>
    </a>
  </div>
  <div class="text-label-caps font-label-caps text-on-surface-variant">
    <span id="pagination-status">Página {currentPage} de {totalPages}</span>
  </div>
</div>
