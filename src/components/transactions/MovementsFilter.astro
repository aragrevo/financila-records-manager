---
interface Props {
  accounts: string[];
  types: string[];
  totalRecords: number;
}

const { accounts, types, totalRecords } = Astro.props;
---

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 mb-6 flex justify-end">
  <div>
    <span class="text-body-md font-body-md text-on-surface-variant">Mostrando {totalRecords} registros</span>
  </div>
</div>
