---
interface FundItem {
  label: string;
  color: string;
  amount: string;
}

interface Props {
  title: string;
  percentage: number;
  funds: FundItem[];
}

const { title, percentage, funds } = Astro.props;
---

<div
  class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm flex flex-col"
>
  <h3 class="text-headline-md font-headline-md mb-6">{title}</h3>
  <div class="flex-1 flex flex-col items-center justify-center space-y-4">
    <div
      class="relative w-48 h-48 rounded-full flex items-center justify-center"
      style={`background: conic-gradient(var(--color-retirement) 0% ${percentage}%, var(--color-surface-container) ${percentage}% 100%);`}
    >
      <div class="w-[150px] h-[150px] rounded-full bg-surface-container-lowest flex items-center justify-center">
        <div class="text-center">
          <span class="text-label-caps block">PARTICIPACIÓN</span>
          <span class="text-headline-lg font-headline-lg">{percentage}%</span>
        </div>
      </div>
    </div>
    <div class="w-full space-y-2">
      {
        funds.map((fund) => (
          <div class="flex justify-between items-center text-body-md">
            <span class="flex items-center">
              <span class:list={["w-3 h-3 rounded-full mr-2", fund.color]} />
              {fund.label}
            </span>
            <span class="font-mono-data font-bold">{fund.amount}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>
