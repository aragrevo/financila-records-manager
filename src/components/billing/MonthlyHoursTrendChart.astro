---
import type { MonthlyBillingTrendPoint } from "../../lib/types";

interface Props {
  monthlyTrend: MonthlyBillingTrendPoint[];
}

const { monthlyTrend } = Astro.props;

const chartWidth = 760;
const chartHeight = 350;
const chartPadding = { top: 16, right: 20, bottom: 48, left: 44 };
const drawableWidth = chartWidth - chartPadding.left - chartPadding.right;
const drawableHeight = chartHeight - chartPadding.top - chartPadding.bottom;
const maxTrendValue = Math.max(
  0,
  ...monthlyTrend.map((point) => point.totalHours),
);
const roundedMaxTrend =
  maxTrendValue > 0 ? Math.ceil(maxTrendValue / 25) * 25 : 25;
const yTicks = Array.from(
  { length: 6 },
  (_, index) => (roundedMaxTrend / 5) * index,
);

const chartPoints = monthlyTrend.map((point, index) => {
  const x =
    chartPadding.left +
    (index / Math.max(monthlyTrend.length - 1, 1)) * drawableWidth;
  const y =
    chartHeight -
    chartPadding.bottom -
    (point.totalHours / roundedMaxTrend) * drawableHeight;

  return {
    ...point,
    x,
    y,
  };
});

const chartPolyline = chartPoints
  .map((point) => `${point.x},${point.y}`)
  .join(" ");
---

<section
  class="xl:col-span-3 rounded-xl border border-outline-variant bg-surface-container-lowest p-6 shadow-sm"
>
  <div class="mb-4">
    <h2 class="text-headline-md font-headline-md text-on-surface">
      Monthly Hours Trend
    </h2>
    <p class="text-body-md text-on-surface-variant">
      Monthly workload trend based on the recorded billing history.
    </p>
  </div>

  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${chartWidth} ${chartHeight}`}
      class="min-w-[720px]"
      role="img"
      aria-label="Line chart showing the monthly hours trend"
    >
      {
        yTicks.map((tick) => {
          const y =
            chartHeight -
            chartPadding.bottom -
            (tick / roundedMaxTrend) * drawableHeight;

          return (
            <g>
              <line
                x1={chartPadding.left}
                x2={chartWidth - chartPadding.right}
                y1={y}
                y2={y}
                stroke="#e0e3e5"
                stroke-width="1"
              />
              <text
                x={chartPadding.left - 10}
                y={y + 4}
                text-anchor="end"
                font-size="11"
                fill="#76777d"
              >
                {tick.toFixed(0)}
              </text>
            </g>
          );
        })
      }

      <line
        x1={chartPadding.left}
        x2={chartWidth - chartPadding.right}
        y1={chartHeight - chartPadding.bottom}
        y2={chartHeight - chartPadding.bottom}
        stroke="#c6c6cd"
        stroke-width="1.5"></line>

      {
        chartPoints.length > 0 && (
          <polyline
            fill="none"
            stroke="#2563eb"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            points={chartPolyline}
          />
        )
      }

      {
        chartPoints.map((point, index) => (
          <g>
            <circle cx={point.x} cy={point.y} r="3.5" fill="#2563eb" />
            <text
              x={point.x}
              y={point.y - 10}
              text-anchor="middle"
              font-size="10"
              font-weight="700"
              fill="#2563eb"
            >
              {point.totalHours.toFixed(1).replace(".0", "")}
            </text>
            {index % 2 === 0 && (
              <text
                x={point.x}
                y={chartHeight - 16}
                text-anchor="end"
                transform={`rotate(-40 ${point.x} ${chartHeight - 16})`}
                font-size="10"
                fill="#76777d"
              >
                {point.monthLabel}
              </text>
            )}
          </g>
        ))
      }
    </svg>
  </div>
</section>
