---
import type { ProjectionSettings } from "../../lib/types";

interface Props {
  settings: ProjectionSettings;
}

const { settings } = Astro.props;
---

<div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
  <div class="mb-5 flex items-center justify-between">
    <div>
      <p class="text-label-caps font-label-caps text-on-surface-variant">Assumptions</p>
      <h2 class="mt-1 text-lg font-bold text-on-surface">Your plan</h2>
    </div>
    <span class="material-symbols-outlined text-primary">tune</span>
  </div>
  <div class="space-y-4">
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Current age</span><input id="current-age" type="number" min="1" max="100" value={settings.currentAge} class="projection-input" /></label>
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Target age</span><input id="target-age" type="number" min="2" max="120" value={settings.targetAge} class="projection-input" /></label>
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Starting capital</span><input id="starting-capital" type="number" min="0" step="100000" value={settings.startingCapital} class="projection-input" /></label>
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Monthly contribution</span><input id="monthly-contribution" type="number" min="0" step="50000" value={settings.monthlyContribution} class="projection-input" /></label>
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Expected annual return</span><div class="relative"><input id="annual-return" type="number" min="0" max="100" step="0.1" value={settings.annualReturn} class="projection-input pr-10" /><span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-on-surface-variant">%</span></div></label>
    <label class="block"><span class="mb-1 block text-xs font-semibold text-on-surface-variant">Projection start</span><input id="start-date" type="month" value={settings.startDate} class="projection-input" /></label>
  </div>
  <div class="mt-5 border-t border-outline-variant pt-4 text-xs leading-5 text-on-surface-variant">
    Monthly rate is calculated from annual effective return. Contributions are assumed at month end.
  </div>
</div>
