---
import { getCurrentPeriods, type ProjectionResult } from "../../lib/projection";
import type { ProjectionSettings } from "../../lib/types";
import { formatCurrencyCOP } from "../../utils/format";

interface Props { projection: ProjectionResult; settings: ProjectionSettings; }
const { projection, settings } = Astro.props;
const currentPeriods = getCurrentPeriods(settings, projection.months);
---

<section class="rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm">
  <div class="flex flex-col gap-3 border-b border-outline-variant p-5 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-label-caps font-label-caps text-on-surface-variant">Monthly schedule</p><h2 class="mt-1 text-lg font-bold text-on-surface">Projection detail</h2></div><span class="rounded-full bg-surface-container-low px-3 py-1 text-xs font-semibold text-on-surface-variant">{projection.months.toLocaleString()} periods · {formatCurrencyCOP(projection.futureValue)} projected</span></div>
  <div class="max-h-[540px] overflow-auto"><table class="data-table min-w-[900px]"><thead><tr><th>Period</th><th>Date</th><th class="text-right">Opening capital</th><th class="text-right">Expected contribution</th><th class="text-right">Interest</th><th class="text-right">Closing capital</th><th class="w-24"></th></tr></thead><tbody>
    {projection.rows.map((row) => <tr data-projection-row={row.monthKey} data-current-projection-row={row.month === currentPeriods ? "true" : undefined} class:list={row.month === currentPeriods && "current-projection-row"}><td class="font-semibold">{row.month}</td><td><span>{row.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>{row.month === currentPeriods ? <span class="current-month-badge">Current</span> : null}</td><td class="text-right font-mono">{formatCurrencyCOP(row.opening)}</td><td class="text-right"><span data-contribution-display class="font-mono text-retirement">{formatCurrencyCOP(row.contribution)}</span><form data-inline-contribution-form class="hidden items-center justify-end"><input data-contribution-month={row.monthKey} type="number" min="0" step="50000" value={row.contribution} class="monthly-contribution-input" aria-label={`Contribution for ${row.monthKey}`} /></form></td><td class="text-right font-mono text-investment">{formatCurrencyCOP(row.interest)}</td><td class="text-right font-mono font-bold">{formatCurrencyCOP(row.closing)}</td><td class="text-right"><div class="flex justify-end gap-1"><button type="button" data-edit-projection-month={row.monthKey} class="inline-flex h-8 w-8 items-center justify-center rounded-full text-contingency transition-colors hover:bg-contingency/10" title="Edit contribution" aria-label="Edit contribution"><span class="material-symbols-outlined text-[18px]">edit</span></button><button type="button" data-save-projection-month={row.monthKey} class="hidden h-8 w-8 items-center justify-center rounded-full text-retirement transition-colors hover:bg-retirement/10" title="Save contribution" aria-label="Save contribution"><span class="material-symbols-outlined text-[18px]">save</span></button><button type="button" data-cancel-projection-month={row.monthKey} class="hidden h-8 w-8 items-center justify-center rounded-full text-on-surface-variant transition-colors hover:bg-surface-container-high" title="Cancel editing" aria-label="Cancel editing"><span class="material-symbols-outlined text-[18px]">close</span></button></div></td></tr>)}
  </tbody></table></div>
</section>
