---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" activePage="">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-headline-lg font-bold text-on-surface">404</h1>
    <p class="text-body-md text-on-surface-variant mt-2">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-6 px-4 py-2 bg-primary text-on-primary rounded hover:bg-primary/90 transition-colors"
    >
      Back to Dashboard
    </a>
  </div>
</Layout>
