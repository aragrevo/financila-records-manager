---
import Layout from "../layouts/Layout.astro";
import SummaryCard from "../components/dashboard/SummaryCard.astro";
import { expensesService } from "../services/expenses.service";
import { expenseSettingsService } from "../services/expense-settings.service";
import {
  EXPENSE_CATEGORIES,
  EXPENSE_CATEGORY_COLORS,
} from "../lib/expense-constants";
import MonthlyExpensesChart from "../components/expenses/MonthlyExpensesChart.astro";

const expenses = await expensesService.getAll();
const settings = await expenseSettingsService.get();
const monthFormatter = new Intl.DateTimeFormat("es-ES", {
  month: "short",
  year: "numeric",
});
const money = (amount: number, currency = settings.currency) =>
  new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency,
    minimumFractionDigits: 2,
  }).format(amount);
const monthKey = (date: string) => date.slice(0, 7);
const monthLabel = (key: string) =>
  monthFormatter.format(new Date(`${key}-01T00:00:00Z`)).replace(" de ", " ");
const months = [...new Set(expenses.map((expense) => monthKey(expense.date)))]
  .sort()
  .reverse();
const currentMonth = new Date().toISOString().slice(0, 7);
const categories = [...EXPENSE_CATEGORIES];
const summary = categories.map((category) => {
  const values = Object.fromEntries(
    months.map((month) => [
      month,
      expenses
        .filter(
          (expense) =>
            expense.category === category && monthKey(expense.date) === month,
        )
        .reduce((sum, expense) => sum + expense.amount, 0),
    ]),
  );
  return {
    category,
    values,
    total: Object.values(values).reduce((sum, value) => sum + value, 0),
  };
});
const monthTotals = Object.fromEntries(
  months.map((month) => [
    month,
    expenses
      .filter((expense) => monthKey(expense.date) === month)
      .reduce((sum, expense) => sum + expense.amount, 0),
  ]),
);
const total = expenses.reduce((sum, expense) => sum + expense.amount, 0);
const currentMonthTotal = expenses
  .filter((expense) => monthKey(expense.date) === currentMonth)
  .reduce((sum, expense) => sum + expense.amount, 0);
const currentMonthCategoryTotals = categories
  .map((category) => ({
    category,
    amount: expenses
      .filter(
        (expense) =>
          monthKey(expense.date) === currentMonth &&
          expense.category === category,
      )
      .reduce((sum, expense) => sum + Math.abs(expense.amount), 0),
  }))
  .filter((entry) => entry.amount > 0)
  .sort((a, b) => b.amount - a.amount);
const topCurrentCategory = currentMonthCategoryTotals[0];
---

<Layout title="Gastos" activePage="expenses">
  <div
    class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
  >
    <div>
      <p class="mb-2 text-label-caps font-label-caps text-primary">
        Control de gastos
      </p>
      <h2 class="text-headline-lg font-headline-lg text-on-surface">Gastos</h2>
      <p class="text-body-md text-on-surface-variant">
        Registro independiente y resumen mensual por comercio.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button
        id="send-report-button"
        class="flex items-center gap-2 rounded-lg border border-outline-variant bg-surface px-4 py-2 text-label-caps font-label-caps hover:bg-surface-container"
        ><span class="material-symbols-outlined text-sm">mail</span>Enviar
        resumen</button
      >
      <button
        id="settings-button"
        class="flex items-center gap-2 rounded-lg border border-outline-variant bg-surface px-4 py-2 text-label-caps font-label-caps hover:bg-surface-container"
        ><span class="material-symbols-outlined text-sm">settings</span
        >Configuración</button
      >
      <button
        id="new-expense-button"
        class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-label-caps font-label-caps text-on-primary hover:opacity-90"
        ><span class="material-symbols-outlined text-sm">add</span>Nuevo gasto</button
      >
    </div>
  </div>

  <section class="mb-gutter grid grid-cols-1 gap-gutter sm:grid-cols-3">
    <SummaryCard
      title="Total registrado"
      value={money(total)}
      subtitle={`${expenses.length} registros`}
      subtitleType="neutral"
      icon="account_balance_wallet"
      accentColor="primary"
    />
    <SummaryCard
      title={`Valor de ${monthLabel(currentMonth)}`}
      value={money(currentMonthTotal)}
      subtitle="Mes actual"
      subtitleType="neutral"
      icon="calendar_month"
      accentColor="retirement"
    />
    <SummaryCard
      title={`Mayor gasto de ${monthLabel(currentMonth)}`}
      subtitle={topCurrentCategory?.category || "Sin datos"}
      value={topCurrentCategory
        ? money(topCurrentCategory.amount)
        : "Sin gastos registrados"}
      subtitleType="neutral"
      icon="category"
      accentColor="investment"
    />
  </section>

  <section
    class="mb-8 overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest"
  >
    <MonthlyExpensesChart
      months={months}
      summary={summary}
      monthTotals={monthTotals}
      monthLabel={monthLabel}
      money={money}
    />
    <div class="overflow-x-auto">
      <details class="border-t border-outline-variant">
        <summary
          class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-on-surface-variant"
          ><span>Ver desglose exacto por categoría</span><span
            class="material-symbols-outlined summary-chevron transition-transform"
            >expand_more</span
          ></summary
        >
        <table class="w-full min-w-[720px] border-collapse text-left">
          <thead
            class="bg-surface-container-high text-label-caps text-on-surface-variant"
            ><tr
              ><th class="px-5 py-3">Categoría</th>{
                months.map((month) => (
                  <th class="px-5 py-3 text-right">{monthLabel(month)}</th>
                ))
              }<th class="px-5 py-3 text-right">Suma total</th></tr
            ></thead
          >
          <tbody class="divide-y divide-outline-variant">
            {
              summary.map((row) => (
                <tr class="hover:bg-surface-container-low">
                  <td class="px-5 py-3 font-semibold">{row.category}</td>
                  {months.map((month) => (
                    <td class="px-5 py-3 text-right font-mono text-sm">
                      {row.values[month] ? money(row.values[month]) : "—"}
                    </td>
                  ))}
                  <td class="px-5 py-3 text-right font-mono font-bold">
                    {money(row.total)}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot
            class="border-t-2 border-primary bg-surface-container-high font-bold"
            ><tr
              ><td class="px-5 py-3">Suma total</td>{
                months.map((month) => (
                  <td class="px-5 py-3 text-right font-mono">
                    {money(monthTotals[month])}
                  </td>
                ))
              }<td class="px-5 py-3 text-right font-mono">{money(total)}</td
              ></tr
            ></tfoot
          >
        </table>
      </details>
    </div>
  </section>

  <style>
    details[open] .summary-chevron {
      transform: rotate(180deg);
    }
  </style>

  <section
    class="overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest"
  >
    <div
      class="flex flex-col gap-3 border-b border-outline-variant p-5 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h3 class="text-headline-md font-headline-md">Detalle de gastos</h3>
      </div><input
        id="description-filter"
        class="rounded-lg border border-outline-variant bg-surface px-3 py-2 text-sm"
        placeholder="Buscar descripción"
      />
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] border-collapse text-left">
        <thead
          class="bg-surface-container-low text-label-caps text-on-surface-variant"
          ><tr
            ><th class="px-5 py-3">Fecha</th><th class="px-5 py-3"
              ><span>Mes</span>
              <span
                class="rounded-full bg-surface-container px-1.5 py-0.5 text-[10px] font-semibold"
                data-expense-filter-count="month">0</span
              >
              <details
                class="relative inline-block text-left normal-case"
                data-expense-filter-menu
              >
                <summary
                  class="inline-flex cursor-pointer list-none align-middle"
                  ><span class="material-symbols-outlined text-sm"
                    >filter_list</span
                  ></summary
                ><div
                  class="absolute left-0 z-20 mt-2 w-48 rounded-xl border border-outline-variant bg-surface p-3 shadow-lg"
                >
                  <p
                    class="mb-2 text-[11px] font-semibold uppercase tracking-wide"
                  >
                    Filtrar meses
                  </p><div class="grid gap-2">
                    {
                      months.map((month) => (
                        <label class="flex items-center gap-2 text-sm font-normal text-on-surface">
                          <input
                            type="checkbox"
                            value={month}
                            checked={month === currentMonth}
                            data-expense-filter-option="month"
                            class="h-4 w-4 rounded border-outline-variant text-primary"
                          />
                          {monthLabel(month)}
                        </label>
                      ))
                    }
                  </div>
                </div>
              </details></th
            ><th class="px-5 py-3"
              ><span>Categoría</span>
              <span
                class="rounded-full bg-surface-container px-1.5 py-0.5 text-[10px] font-semibold"
                data-expense-filter-count="category">0</span
              >
              <details
                class="relative inline-block text-left normal-case"
                data-expense-filter-menu
              >
                <summary
                  class="inline-flex cursor-pointer list-none align-middle"
                  ><span class="material-symbols-outlined text-sm"
                    >filter_list</span
                  ></summary
                ><div
                  class="absolute left-0 z-20 mt-2 w-52 rounded-xl border border-outline-variant bg-surface p-3 shadow-lg"
                >
                  <p
                    class="mb-2 text-[11px] font-semibold uppercase tracking-wide"
                  >
                    Filtrar categorías
                  </p><div class="grid gap-2">
                    {
                      categories.map((category) => (
                        <label class="flex items-center gap-2 text-sm font-normal text-on-surface">
                          <input
                            type="checkbox"
                            value={category}
                            data-expense-filter-option="category"
                            class="h-4 w-4 rounded border-outline-variant text-primary"
                          />
                          {category}
                        </label>
                      ))
                    }
                  </div>
                </div>
              </details></th
            ><th class="px-5 py-3">Descripción</th><th
              class="px-5 py-3 text-right">Importe</th
            ><th class="px-3 py-3 max-w-16"></th></tr
          ></thead
        ><tbody id="expense-rows" class="divide-y divide-outline-variant"
          >{
            expenses.map((expense) => (
              <tr
                class="expense-row hover:bg-surface-container-low"
                data-description={expense.description.toLowerCase()}
                data-category={expense.category}
                data-month={monthKey(expense.date)}
              >
                <>
                  <td class="px-5 py-3 font-mono text-sm">{expense.date}</td>
                  <td class="px-5 py-3 text-sm text-on-surface-variant">
                    {monthLabel(monthKey(expense.date))}
                  </td>
                  <td class="px-5 py-3">
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-container px-2 py-1 text-xs">
                      <span
                        class="h-2 w-2 rounded-full"
                        style={`background-color: ${EXPENSE_CATEGORY_COLORS[expense.category] || "#64748b"}`}
                      />
                      {expense.category}
                    </span>
                  </td>
                  <td class="px-5 py-3 text-sm">
                    {expense.description || "—"}
                  </td>
                  <td
                    class:list={[
                      "px-5 py-3 text-right font-mono font-semibold",
                      expense.amount < 0 ? "text-error" : "text-secondary",
                    ]}
                  >
                    {money(expense.amount, expense.currency)}
                  </td>
                  <td class="px-3 py-3 max-w-16">
                    <div class="flex gap-1">
                      <>
                        <button
                          class="edit-expense rounded p-1 text-on-surface-variant hover:text-primary"
                          data-expense={JSON.stringify(expense)}
                          aria-label="Editar gasto"
                        >
                          <span class="material-symbols-outlined text-lg">
                            edit
                          </span>
                        </button>
                        <button
                          class="clone-expense rounded p-1 text-on-surface-variant hover:text-primary"
                          data-expense={JSON.stringify(expense)}
                          aria-label="Clonar gasto"
                        >
                          <span class="material-symbols-outlined text-lg">
                            content_copy
                          </span>
                        </button>
                        <button
                          class="delete-expense rounded p-1 text-on-surface-variant hover:text-error"
                          data-id={expense.id}
                          aria-label="Eliminar gasto"
                        >
                          <span class="material-symbols-outlined text-lg">
                            delete
                          </span>
                        </button>
                      </>
                    </div>
                  </td>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
    <div
      class="flex items-center justify-between border-t border-outline-variant px-5 py-3"
    >
      <p id="expense-pagination-info" class="text-xs text-on-surface-variant">
      </p><div class="flex items-center gap-2">
        <button
          id="expense-page-prev"
          type="button"
          class="rounded-lg border border-outline-variant px-3 py-1.5 text-xs font-semibold disabled:cursor-not-allowed disabled:opacity-40"
          >Anterior</button
        ><span
          id="expense-pagination-page"
          class="min-w-16 text-center text-xs font-semibold text-on-surface-variant"
        ></span><button
          id="expense-page-next"
          type="button"
          class="rounded-lg border border-outline-variant px-3 py-1.5 text-xs font-semibold disabled:cursor-not-allowed disabled:opacity-40"
          >Siguiente</button
        >
      </div>
    </div>
  </section>

  <div
    id="expense-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
  >
    <div class="w-full max-w-lg rounded-xl bg-surface shadow-xl">
      <div
        class="flex items-center justify-between border-b border-outline-variant p-5"
      >
        <h3 id="expense-modal-title" class="text-headline-md font-headline-md">
          Nuevo gasto
        </h3><button data-close="expense-modal" class="text-on-surface-variant"
          ><span class="material-symbols-outlined">close</span></button
        >
      </div><form id="expense-form" class="grid gap-4 p-5">
        <input type="hidden" name="id" /><div class="grid grid-cols-2 gap-4">
          <label class="text-sm"
            >Fecha<input
              required
              type="date"
              name="date"
              class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"
            /></label
          ><label class="text-sm"
            >Importe<input
              required
              step="0.01"
              type="number"
              name="amount"
              placeholder="-5.73 o 140.00"
              class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"
            /></label
          >
        </div><div class="grid grid-cols-2 gap-4">
          <label class="text-sm"
            >Moneda<input
              required
              maxlength="3"
              name="currency"
              class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2 uppercase"
            /></label
          ><label class="text-sm"
            >Categoría<select
              required
              name="category"
              class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"
              >{
                categories.map((category) => (
                  <option value={category}>{category}</option>
                ))
              }</select
            ></label
          >
        </div><label class="text-sm"
          >Descripción<textarea
            name="description"
            rows="2"
            class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"
          ></textarea></label
        ><div class="flex justify-end gap-3 pt-2">
          <button
            type="button"
            data-close="expense-modal"
            class="rounded-lg border border-outline-variant px-4 py-2"
            >Cancelar</button
          ><button
            class="rounded-lg bg-primary px-4 py-2 font-bold text-on-primary"
            >Guardar gasto</button
          >
        </div>
      </form>
    </div>
  </div>

  <div
    id="settings-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
  >
    <div class="w-full max-w-lg rounded-xl bg-surface shadow-xl">
      <div
        class="flex items-center justify-between border-b border-outline-variant p-5"
      >
        <h3 class="text-headline-md font-headline-md">Configuración</h3><button
          data-close="settings-modal"
          class="text-on-surface-variant"
          ><span class="material-symbols-outlined">close</span></button
        >
      </div><form id="settings-form" class="grid gap-4 p-5">
        <p
          class="rounded-lg bg-surface-container-low p-3 text-xs text-on-surface-variant"
        >
          Configura <code>RESEND_API_KEY</code> y <code
            >NOTIFICATION_FROM_EMAIL</code
          > en el servidor.
        </p><label class="text-sm"
          >Moneda predeterminada<input
            required
            maxlength="3"
            name="currency"
            value={settings.currency}
            class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2 uppercase"
          /></label
        ><label class="text-sm"
          >Correos destinatarios<input
            type="text"
            name="recipientEmail"
            value={settings.recipientEmail}
            placeholder="uno@ejemplo.com, dos@ejemplo.com"
            class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"
          /><span class="mt-1 block text-xs text-on-surface-variant"
            >Separar varios correos con comas.</span
          ></label
        ><div class="flex justify-end gap-3 pt-2">
          <button
            type="button"
            data-close="settings-modal"
            class="rounded-lg border border-outline-variant px-4 py-2"
            >Cancelar</button
          ><button
            class="rounded-lg bg-primary px-4 py-2 font-bold text-on-primary"
            >Guardar configuración</button
          >
        </div>
      </form>
    </div>
  </div>
</Layout>

<script define:vars={{ defaultCurrency: settings.currency }}>
  const expenseModal = document.getElementById("expense-modal");
  const settingsModal = document.getElementById("settings-modal");
  const expenseForm = document.getElementById("expense-form");
  const settingsForm = document.getElementById("settings-form");
  const open = (element) => {
    element?.classList.remove("hidden");
    element?.classList.add("flex");
  };
  const close = (element) => {
    element?.classList.add("hidden");
    element?.classList.remove("flex");
  };
  const setValue = (name, value) => {
    const field = expenseForm?.elements.namedItem(name);
    if (field) field.value = value ?? "";
  };
  document
    .getElementById("new-expense-button")
    ?.addEventListener("click", () => {
      expenseForm.reset();
      setValue("id", "");
      setValue("currency", defaultCurrency);
      setValue("date", new Date().toISOString().slice(0, 10));
      document.getElementById("expense-modal-title").textContent =
        "Nuevo gasto";
      open(expenseModal);
    });
  document
    .getElementById("settings-button")
    ?.addEventListener("click", () => open(settingsModal));
  document
    .querySelectorAll("[data-close]")
    .forEach((button) =>
      button.addEventListener("click", () =>
        close(document.getElementById(button.dataset.close)),
      ),
    );
  document.querySelectorAll(".edit-expense").forEach((button) =>
    button.addEventListener("click", () => {
      const expense = JSON.parse(button.dataset.expense);
      Object.entries(expense).forEach(([key, value]) => setValue(key, value));
      document.getElementById("expense-modal-title").textContent =
        "Editar gasto";
      open(expenseModal);
    }),
  );
  document.querySelectorAll(".clone-expense").forEach((button) =>
    button.addEventListener("click", () => {
      const expense = JSON.parse(button.dataset.expense);
      expenseForm.reset();
      Object.entries(expense).forEach(([key, value]) => setValue(key, value));
      setValue("id", "");
      setValue("date", new Date().toISOString().slice(0, 10));
      document.getElementById("expense-modal-title").textContent =
        "Clonar gasto";
      open(expenseModal);
    }),
  );
  expenseForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(expenseForm));
    const id = data.id;
    delete data.id;
    const response = await fetch(id ? `/api/expenses/${id}` : "/api/expenses", {
      method: id ? "PUT" : "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
    const result = await response.json();
    if (!response.ok) {
      alert(result.error || "No se pudo guardar");
      return;
    }
    window.location.reload();
  });
  document.querySelectorAll(".delete-expense").forEach((button) =>
    button.addEventListener("click", async () => {
      if (!confirm("¿Eliminar este gasto?")) return;
      const response = await fetch(`/api/expenses/${button.dataset.id}`, {
        method: "DELETE",
      });
      const result = await response.json();
      if (!response.ok) {
        alert(result.error || "No se pudo eliminar el gasto");
        return;
      }
      window.location.reload();
    }),
  );
  document
    .getElementById("send-report-button")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget;
      button.disabled = true;
      button.textContent = "Enviando...";
      const response = await fetch("/api/expenses/report-email", {
        method: "POST",
      });
      const result = await response.json();
      button.disabled = false;
      button.innerHTML =
        '<span class="material-symbols-outlined text-sm">mail</span>Enviar resumen';
      alert(
        response.ok
          ? "Resumen enviado por correo."
          : result.error || "No se pudo enviar el resumen.",
      );
    });
  settingsForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(settingsForm));
    const response = await fetch("/api/expense-settings", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
    if (!response.ok) {
      alert((await response.json()).error || "No se pudo guardar");
      return;
    }
    close(settingsModal);
    alert("Configuración guardada");
  });
  const selectedFilters = (type) =>
    Array.from(
      document.querySelectorAll(
        `input[data-expense-filter-option="${type}"]:checked`,
      ),
    ).map((input) => input.value);
  const pageSize = 10;
  let currentPage = 1;
  let matchingRows = [];
  const renderPage = () => {
    const totalPages = Math.max(1, Math.ceil(matchingRows.length / pageSize));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * pageSize;
    const visibleRows = matchingRows.slice(start, start + pageSize);
    document.querySelectorAll("#expense-rows .expense-row").forEach((row) => {
      row.hidden = !visibleRows.includes(row);
      row.classList.toggle("hidden", !visibleRows.includes(row));
    });
    const info = document.getElementById("expense-pagination-info");
    if (info)
      info.textContent = matchingRows.length
        ? `Mostrando ${start + 1}-${Math.min(start + pageSize, matchingRows.length)} de ${matchingRows.length}`
        : "Sin resultados";
    const page = document.getElementById("expense-pagination-page");
    if (page) page.textContent = `Página ${currentPage} de ${totalPages}`;
    const previous = document.getElementById("expense-page-prev");
    const next = document.getElementById("expense-page-next");
    if (previous) previous.disabled = currentPage <= 1;
    if (next) next.disabled = currentPage >= totalPages;
  };
  const applyFilters = () => {
    const categories = selectedFilters("category");
    const months = selectedFilters("month");
    const description = (
      document.getElementById("description-filter")?.value ?? ""
    )
      .trim()
      .toLowerCase();
    matchingRows = Array.from(
      document.querySelectorAll("#expense-rows .expense-row"),
    ).filter(
      (row) =>
        (!categories.length ||
          categories.includes(row.dataset.category ?? "")) &&
        (!months.length || months.includes(row.dataset.month ?? "")) &&
        (!description || (row.dataset.description ?? "").includes(description)),
    );
    currentPage = 1;
    ["category", "month"].forEach((type) => {
      const badge = document.querySelector(
        `[data-expense-filter-count="${type}"]`,
      );
      if (badge) badge.textContent = String(selectedFilters(type).length);
    });
    const count = document.getElementById("expense-count");
    if (count) count.textContent = `${matchingRows.length} registros`;
    renderPage();
  };
  document
    .querySelectorAll("input[data-expense-filter-option]")
    .forEach((input) => input.addEventListener("change", applyFilters));
  document
    .getElementById("description-filter")
    ?.addEventListener("input", applyFilters);
  document
    .getElementById("expense-page-prev")
    ?.addEventListener("click", () => {
      currentPage -= 1;
      renderPage();
    });
  document
    .getElementById("expense-page-next")
    ?.addEventListener("click", () => {
      currentPage += 1;
      renderPage();
    });
  applyFilters();
</script>
