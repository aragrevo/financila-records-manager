---
import Layout from '../layouts/Layout.astro';
import TransactionTable from '../components/transactions/TransactionTable.astro';
import { transactionsData, getTotalIncome, getTotalExpenses } from '../data/transactions';
import { formatCurrency } from '../data/summary';

const totalIncome = getTotalIncome();
const totalExpenses = getTotalExpenses();
const netCashFlow = totalIncome - totalExpenses;
---

<Layout title="Transaction History" activePage="history">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-headline-lg font-bold text-on-surface">Transaction History</h1>
        <p class="text-body-md text-on-surface-variant mt-1">View and analyze your financial transactions</p>
      </div>
      <button class="px-4 py-2 bg-primary text-on-primary rounded hover:bg-primary/90 transition-colors">
        Add Transaction
      </button>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white rounded-lg shadow-card p-6">
        <p class="text-label-caps text-on-surface-variant uppercase">Total Income</p>
        <p class="text-headline-md font-bold text-retirement mt-2 financial-figure">
          {formatCurrency(totalIncome)}
        </p>
        <p class="text-sm text-on-surface-variant mt-1">This month</p>
      </div>
      
      <div class="bg-white rounded-lg shadow-card p-6">
        <p class="text-label-caps text-on-surface-variant uppercase">Total Expenses</p>
        <p class="text-headline-md font-bold text-error mt-2 financial-figure">
          {formatCurrency(totalExpenses)}
        </p>
        <p class="text-sm text-on-surface-variant mt-1">This month</p>
      </div>
      
      <div class="bg-white rounded-lg shadow-card p-6">
        <p class="text-label-caps text-on-surface-variant uppercase">Net Cash Flow</p>
        <p class:list={['text-headline-md font-bold mt-2 financial-figure', netCashFlow >= 0 ? 'text-retirement' : 'text-error']}>
          {formatCurrency(netCashFlow)}
        </p>
        <p class="text-sm text-on-surface-variant mt-1">This month</p>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-card p-6">
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-sm font-medium text-on-surface mb-1">Search</label>
          <input
            type="search"
            placeholder="Search transactions..."
            class="w-full px-3 py-2 border border-outline-variant rounded text-sm focus:outline-none focus:ring-2 focus:ring-contingency"
          />
        </div>
        
        <div>
          <label class="block text-sm font-medium text-on-surface mb-1">Type</label>
          <select class="px-3 py-2 border border-outline-variant rounded text-sm focus:outline-none focus:ring-2 focus:ring-contingency">
            <option value="all">All Types</option>
            <option value="income">Income</option>
            <option value="expense">Expense</option>
            <option value="transfer">Transfer</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-on-surface mb-1">Category</label>
          <select class="px-3 py-2 border border-outline-variant rounded text-sm focus:outline-none focus:ring-2 focus:ring-contingency">
            <option value="all">All Categories</option>
            <option value="salary">Salary</option>
            <option value="freelance">Freelance</option>
            <option value="food">Food & Groceries</option>
            <option value="utilities">Utilities</option>
            <option value="entertainment">Entertainment</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-on-surface mb-1">Date Range</label>
          <select class="px-3 py-2 border border-outline-variant rounded text-sm focus:outline-none focus:ring-2 focus:ring-contingency">
            <option value="all">All Time</option>
            <option value="today">Today</option>
            <option value="week">This Week</option>
            <option value="month" selected>This Month</option>
            <option value="quarter">This Quarter</option>
            <option value="year">This Year</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-on-surface mb-1">Account</label>
          <select class="px-3 py-2 border border-outline-variant rounded text-sm focus:outline-none focus:ring-2 focus:ring-contingency">
            <option value="all">All Accounts</option>
            <option value="checking">Main Checking</option>
            <option value="savings">High-Yield Savings</option>
            <option value="investment">Investment Portfolio</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Transactions Table -->
    <div class="bg-white rounded-lg shadow-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-on-surface">Transactions</h2>
        <div class="flex items-center space-x-2">
          <button class="px-3 py-1.5 text-sm border border-outline-variant rounded hover:bg-surface-container-low transition-colors">
            Export CSV
          </button>
          <button class="px-3 py-1.5 text-sm border border-outline-variant rounded hover:bg-surface-container-low transition-colors">
            Print
          </button>
        </div>
      </div>
      
      <TransactionTable transactions={transactionsData} />
      
      <!-- Pagination -->
      <div class="flex items-center justify-between mt-6 pt-4 border-t border-outline-variant">
        <p class="text-sm text-on-surface-variant">
          Showing 1 to {transactionsData.length} of {transactionsData.length} transactions
        </p>
        <div class="flex items-center space-x-2">
          <button class="px-3 py-1.5 text-sm border border-outline-variant rounded opacity-50 cursor-not-allowed">
            Previous
          </button>
          <button class="px-3 py-1.5 text-sm bg-primary text-on-primary rounded">
            1
          </button>
          <button class="px-3 py-1.5 text-sm border border-outline-variant rounded opacity-50 cursor-not-allowed">
            Next
          </button>
        </div>
      </div>
    </div>

    <!-- Spending by Category -->
    <div class="bg-white rounded-lg shadow-card p-6">
      <h3 class="text-lg font-semibold text-on-surface mb-4">Spending by Category</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-3">
          {[
            { name: 'Housing', amount: 1800, percentage: 35, color: 'bg-emergency' },
            { name: 'Food & Groceries', amount: 156, percentage: 15, color: 'bg-investment' },
            { name: 'Transportation', amount: 45, percentage: 10, color: 'bg-contingency' },
            { name: 'Entertainment', amount: 15, percentage: 8, color: 'bg-retirement' },
            { name: 'Healthcare', amount: 250, percentage: 12, color: 'bg-primary' },
          ].map((category) => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-on-surface">{category.name}</span>
                <span class="text-sm font-medium text-on-surface financial-figure">
                  {formatCurrency(category.amount)}
                </span>
              </div>
              <div class="h-2 bg-surface-container rounded-full overflow-hidden">
                <div
                  class:list={['h-full rounded-full', category.color]}
                  style={`width: ${category.percentage}%`}
                />
              </div>
            </div>
          ))}
        </div>
        
        <div class="flex items-center justify-center">
          <div class="text-center">
            <p class="text-label-caps text-on-surface-variant uppercase">Average Daily Spend</p>
            <p class="text-headline-lg font-bold text-on-surface mt-2 financial-figure">
              {formatCurrency(totalExpenses / 30)}
            </p>
            <p class="text-sm text-on-surface-variant mt-1">Based on this month</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
