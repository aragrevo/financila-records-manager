---
import Layout from '../layouts/Layout.astro';
import MovementsFilter from '../components/transactions/MovementsFilter.astro';
import MovementsTable from '../components/transactions/MovementsTable.astro';
import Pagination from '../components/transactions/Pagination.astro';
import { dashboardService } from '../services/dashboard.service';
import { formatCurrencyCOP } from '../utils/format';

const [movements, accounts, types] = await Promise.all([
  dashboardService.getMovements(),
  dashboardService.getMovementAccounts(),
  dashboardService.getMovementTypes(),
]);

const formattedMovements = movements.map(mov => ({
  ...mov,
  amount: mov.amount < 0
    ? `- $ ${formatCurrencyCOP(Math.abs(mov.amount)).replace('$', '').trim()}`
    : `$ ${formatCurrencyCOP(mov.amount).replace('$', '').trim()}`,
  isNegative: mov.amount < 0,
}));
---

<Layout title="Movimientos" activePage="history">
  <!-- Page Heading -->
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h2 class="text-headline-lg font-headline-lg text-primary">Movimientos</h2>
      <p class="text-body-md font-body-md text-on-surface-variant">Registro detallado de transacciones y flujos de capital</p>
    </div>
    <div class="flex gap-3">
      <button class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-colors text-label-caps font-label-caps">
        <span class="material-symbols-outlined text-sm">download</span>
        Exportar CSV
      </button>
      <button class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg hover:opacity-90 transition-opacity text-label-caps font-label-caps">
        <span class="material-symbols-outlined text-sm">add</span>
        Nuevo Registro
      </button>
    </div>
  </div>

  <!-- Filter Bar -->
  <MovementsFilter accounts={accounts} types={types} totalRecords={formattedMovements.length} />

  <!-- Data Table -->
  <MovementsTable movements={formattedMovements} />

  <!-- Pagination -->
  <Pagination currentPage={1} totalPages={45} />
</Layout>

<style>
  .data-table-container {
    height: calc(100vh - 10rem);
  }
</style>
