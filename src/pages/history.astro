---
import Layout from '../layouts/Layout.astro';
import MovementsFilter from '../components/transactions/MovementsFilter.astro';
import MovementsTable from '../components/transactions/MovementsTable.astro';
import Pagination from '../components/transactions/Pagination.astro';
import { formatCurrencyCOP } from '../utils/format';

const accounts = ['XTB', 'Tyba', 'NU', 'MejorCDT', 'Global66'];
const types = ['Investment', 'Retirement', 'Contingency', 'Emergency'];

const movements = [
  { date: '16/05/2026', account: 'XTB', type: 'Investment', amount: `$ ${formatCurrencyCOP(382100).replace('$', '').trim()}` },
  { date: '08/05/2026', account: 'Tyba', type: 'Retirement', amount: `$ ${formatCurrencyCOP(200000).replace('$', '').trim()}` },
  { date: '08/05/2026', account: 'NU', type: 'Contingency', amount: `$ ${formatCurrencyCOP(568611).replace('$', '').trim()}` },
  { date: '08/05/2026', account: 'NU', type: 'Emergency', amount: `$ ${formatCurrencyCOP(1135858).replace('$', '').trim()}` },
  { date: '02/04/2026', account: 'Otro', type: 'Retirement', amount: `- $ ${formatCurrencyCOP(1000000).replace('$', '').trim()}`, isNegative: true },
  { date: '11/03/2026', account: 'MejorCDT', type: 'Retirement', amount: `$ ${formatCurrencyCOP(5000000).replace('$', '').trim()}` },
  { date: '11/03/2026', account: 'NU', type: 'Retirement', amount: `- $ ${formatCurrencyCOP(5000000).replace('$', '').trim()}`, isNegative: true },
  { date: '23/12/2025', account: 'NU', type: 'Contingency', amount: `- $ ${formatCurrencyCOP(4256765).replace('$', '').trim()}`, isNegative: true },
  { date: '05/12/2025', account: 'Global66', type: 'Emergency', amount: `$ ${formatCurrencyCOP(315000).replace('$', '').trim()}` },
  { date: '10/04/2026', account: 'Tyba', type: 'Retirement', amount: `$ ${formatCurrencyCOP(200000).replace('$', '').trim()}` },
  { date: '10/04/2026', account: 'NU', type: 'Contingency', amount: `$ ${formatCurrencyCOP(574096).replace('$', '').trim()}` },
  { date: '10/04/2026', account: 'NU', type: 'Emergency', amount: `$ ${formatCurrencyCOP(1146814).replace('$', '').trim()}` },
];
---

<Layout title="Movimientos" activePage="history">
  <!-- Page Heading -->
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h2 class="text-headline-lg font-headline-lg text-primary">Movimientos</h2>
      <p class="text-body-md font-body-md text-on-surface-variant">Registro detallado de transacciones y flujos de capital</p>
    </div>
    <div class="flex gap-3">
      <button class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-colors text-label-caps font-label-caps">
        <span class="material-symbols-outlined text-sm">download</span>
        Exportar CSV
      </button>
      <button class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg hover:opacity-90 transition-opacity text-label-caps font-label-caps">
        <span class="material-symbols-outlined text-sm">add</span>
        Nuevo Registro
      </button>
    </div>
  </div>

  <!-- Filter Bar -->
  <MovementsFilter accounts={accounts} types={types} totalRecords={movements.length} />

  <!-- Data Table -->
  <MovementsTable movements={movements} />

  <!-- Pagination -->
  <Pagination currentPage={1} totalPages={45} />
</Layout>

<style>
  .data-table-container {
    height: calc(100vh - 10rem);
  }
</style>
