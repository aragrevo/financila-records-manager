---
import Layout from "../layouts/Layout.astro";
import MovementsFilter from "../components/transactions/MovementsFilter.astro";
import MovementsTable from "../components/transactions/MovementsTable.astro";
import Pagination from "../components/transactions/Pagination.astro";
import { dashboardService } from "../services/dashboard.service";
import { TRANSACTION_TYPES, ACCOUNT_CATEGORIES } from "../lib/constants";

const { movements, accounts, types } =
  await dashboardService.getHistoryPageData();

const pageSize = 10;
const requestedPage = Number.parseInt(
  Astro.url.searchParams.get("page") ?? "1",
  10,
);
const totalPages = Math.max(1, Math.ceil(movements.length / pageSize));
const currentPage = Number.isFinite(requestedPage)
  ? Math.min(Math.max(requestedPage, 1), totalPages)
  : 1;
---

<Layout title="Movimientos" activePage="history">
  <!-- Page Heading -->
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h2 class="text-headline-lg font-headline-lg text-primary">
        Movimientos
      </h2>
      <p class="text-body-md font-body-md text-on-surface-variant">
        Registro detallado de transacciones y flujos de capital
      </p>
    </div>
    <div class="flex gap-3">
      <button
        class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-colors text-label-caps font-label-caps"
      >
        <span class="material-symbols-outlined text-sm">download</span>
        Exportar CSV
      </button>
      <button
        id="btn-new-transaction"
        class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg hover:opacity-90 transition-opacity text-label-caps font-label-caps"
      >
        <span class="material-symbols-outlined text-sm">add</span>
        Nuevo Registro
      </button>
    </div>
  </div>

  <!-- Data Table -->
  <MovementsTable movements={movements} />

  <!-- Pagination -->
  <Pagination currentPage={currentPage} totalPages={totalPages} />

  <!-- Create Transaction Modal -->
  <div
    id="create-transaction-modal"
    class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4"
  >
    <div class="bg-surface rounded-xl shadow-xl w-full max-w-md">
      <div
        class="flex items-center justify-between p-6 border-b border-outline-variant"
      >
        <h3 class="text-headline-md font-headline-md text-on-surface">
          Nueva Transacción
        </h3>
        <button
          id="modal-close"
          class="text-on-surface-variant hover:text-on-surface"
        >
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <form id="create-transaction-form" class="p-6 space-y-4">
        <div>
          <label
            for="txn-description"
            class="block text-label-md text-on-surface-variant mb-1"
            >Descripción</label
          >
          <input
            type="text"
            id="txn-description"
            name="description"
            required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            placeholder="Ej: Pago de alquiler"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label
              for="txn-amount"
              class="block text-label-md text-on-surface-variant mb-1"
              >Monto</label
            >
            <input
              type="number"
              id="txn-amount"
              name="amount"
              step="0.01"
              required
              class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
              placeholder="0.00"
            />
          </div>
          <div>
            <label
              for="txn-type"
              class="block text-label-md text-on-surface-variant mb-1"
              >Tipo</label
            >
            <select
              id="txn-type"
              name="type"
              required
              class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            >
              {
                Object.entries(TRANSACTION_TYPES).map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))
              }
            </select>
          </div>
        </div>
        <div>
          <label
            for="txn-account"
            class="block text-label-md text-on-surface-variant mb-1"
            >Cuenta</label
          >
          <select
            id="txn-account"
            name="accountId"
            required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
          >
            <option value="">Seleccionar cuenta</option>
          </select>
        </div>
        <div>
          <label
            for="txn-category"
            class="block text-label-md text-on-surface-variant mb-1"
            >Categoría</label
          >
          <select
            id="txn-category"
            name="categoryId"
            required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
          >
            {
              Object.entries(ACCOUNT_CATEGORIES).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label
            for="txn-date"
            class="block text-label-md text-on-surface-variant mb-1"
            >Fecha</label
          >
          <input
            type="date"
            id="txn-date"
            name="date"
            required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
          />
        </div>
        <div>
          <label
            for="txn-merchant"
            class="block text-label-md text-on-surface-variant mb-1"
            >Comercio (opcional)</label
          >
          <input
            type="text"
            id="txn-merchant"
            name="merchant"
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            placeholder="Ej: Supermercado XYZ"
          />
        </div>
        <div class="flex gap-3 pt-2">
          <button
            type="button"
            id="modal-cancel"
            class="flex-1 px-4 py-2 border border-outline-variant rounded-lg font-bold text-body-md text-on-surface hover:bg-surface-container transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="flex-1 px-4 py-2 bg-primary text-on-primary rounded-lg font-bold text-body-md hover:opacity-90 transition-opacity"
          >
            Crear Transacción
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .data-table-container {
    height: calc(100vh - 10rem);
  }
</style>

<script>
  const modal = document.getElementById("create-transaction-modal");
  const btnNew = document.getElementById("btn-new-transaction");
  const btnClose = document.getElementById("modal-close");
  const btnCancel = document.getElementById("modal-cancel");
  const form = document.getElementById(
    "create-transaction-form",
  ) as HTMLFormElement;
  const accountSelect = document.getElementById(
    "txn-account",
  ) as HTMLSelectElement;
  const dateInput = document.getElementById("txn-date") as HTMLInputElement;
  const typeSelect = document.getElementById("txn-type") as HTMLSelectElement;
  const amountInput = document.getElementById("txn-amount") as HTMLInputElement;

  // Set default date to today
  dateInput.valueAsDate = new Date();

  // Load accounts for dropdown
  async function loadAccounts() {
    try {
      const res = await fetch("/api/accounts");
      if (res.ok) {
        const accounts = await res.json();
        accounts.forEach(
          (acc: { id: string; name: string; category: string }) => {
            const option = document.createElement("option");
            option.value = acc.id;
            option.textContent = `${acc.name} (${acc.category})`;
            accountSelect.appendChild(option);
          },
        );
      }
    } catch (e) {
      console.error("Failed to load accounts:", e);
    }
  }

  loadAccounts();

  function openModal() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
  }

  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    form?.reset();
    dateInput.valueAsDate = new Date();
  }

  btnNew?.addEventListener("click", openModal);
  btnClose?.addEventListener("click", closeModal);
  btnCancel?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Clone a movement into the create form with today's date
  document.addEventListener("click", (event) => {
    const cloneBtn = (event.target as HTMLElement)?.closest<HTMLElement>(
      "[data-clone-transaction]",
    );
    if (!cloneBtn) return;
    const row = cloneBtn.closest<HTMLElement>("tr.movement-row");
    if (!row) return;

    const descriptionInput = document.getElementById(
      "txn-description",
    ) as HTMLInputElement;
    const categorySelect = document.getElementById(
      "txn-category",
    ) as HTMLSelectElement;
    const merchantInput = document.getElementById(
      "txn-merchant",
    ) as HTMLInputElement;

    descriptionInput.value = row.dataset.description ?? "";
    const amount = Number.parseFloat(row.dataset.amount ?? "0");
    amountInput.value = String(Math.abs(amount));
    typeSelect.value = row.dataset.type ?? "expense";
    categorySelect.value = row.dataset.category ?? "";
    accountSelect.value = row.dataset.accountId ?? "";
    merchantInput.value = row.dataset.merchant ?? "";
    dateInput.valueAsDate = new Date();

    openModal();
    descriptionInput.focus();
  });

  // Adjust amount sign based on type
  typeSelect?.addEventListener("change", () => {
    const type = typeSelect.value;
    if (type === "expense") {
      amountInput.placeholder = "-0.00";
    } else {
      amountInput.placeholder = "0.00";
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    let amount = parseFloat(formData.get("amount") as string);
    const type = formData.get("type") as string;

    // Make amount negative for expenses
    if (type === "expense" && amount > 0) {
      amount = -amount;
    }

    const data = {
      description: formData.get("description"),
      amount,
      type,
      accountId: formData.get("accountId"),
      categoryId: formData.get("categoryId"),
      date: formData.get("date"),
      merchant: formData.get("merchant") || undefined,
    };

    try {
      const res = await fetch("/api/transactions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        closeModal();
        window.location.reload();
      } else {
        alert("Error al crear la transacción");
      }
    } catch {
      alert("Error de conexión");
    }
  });

  const movementRows = Array.from(
    document.querySelectorAll<HTMLElement>(".movement-row"),
  );
  const paginationLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-pagination-page]"),
  );
  const paginationNumbers = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-pagination-number]"),
  );
  const paginationControls = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-pagination-direction]"),
  );
  const movementFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>(
      "[data-movement-filter-option]",
    ),
  );
  const movementFilterCounts = Array.from(
    document.querySelectorAll<HTMLElement>("[data-movement-filter-count]"),
  );
  const movementFilterMenus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(
      "[data-movement-filter-menu]",
    ),
  );
  const paginationStatus = document.getElementById("pagination-status");
  const pageSize = 10;
  let filteredRows = movementRows;
  let totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
  let currentPage = Number.parseInt(
    new URLSearchParams(window.location.search).get("page") ?? "1",
    10,
  );
  currentPage = Number.isFinite(currentPage)
    ? Math.min(Math.max(currentPage, 1), totalPages)
    : 1;

  function renderPage(page: number) {
    currentPage = Math.min(Math.max(page, 1), totalPages);
    filteredRows.forEach((row, index) => {
      row.hidden =
        index < (currentPage - 1) * pageSize || index >= currentPage * pageSize;
    });
    movementRows
      .filter((row) => !filteredRows.includes(row))
      .forEach((row) => (row.hidden = true));

    paginationNumbers.forEach((link) => {
      const linkPage = Number(link.dataset.paginationPage);
      const isCurrent = linkPage === currentPage;
      link.hidden = linkPage > totalPages;
      link.toggleAttribute("aria-current", isCurrent);
      link.classList.toggle("bg-primary", isCurrent);
      link.classList.toggle("text-on-primary", isCurrent);
      link.classList.toggle("border", !isCurrent);
    });

    paginationControls.forEach((link) => {
      const direction = link.dataset.paginationDirection;
      const targetPage =
        direction === "previous"
          ? Math.max(1, currentPage - 1)
          : Math.min(totalPages, currentPage + 1);
      const isDisabled =
        direction === "previous"
          ? currentPage === 1
          : currentPage === totalPages;
      link.dataset.paginationPage = String(targetPage);
      link.setAttribute("aria-disabled", String(isDisabled));
      link.classList.toggle("opacity-50", isDisabled);
      link.classList.toggle("pointer-events-none", isDisabled);
    });

    if (paginationStatus) {
      paginationStatus.textContent = `Página ${currentPage} de ${totalPages}`;
    }
  }

  function applyFilters() {
    const selected = new Map<string, Set<string>>();
    movementFilters.forEach((filter) => {
      const key = filter.dataset.movementFilterOption;
      if (!key || !filter.checked) return;
      if (!selected.has(key)) selected.set(key, new Set());
      selected.get(key)?.add(filter.value);
    });
    filteredRows = movementRows.filter((row) =>
      (["account", "type", "category"] as const).every((key) => {
        const values = selected.get(key);
        return !values?.size || values.has(row.dataset[key] ?? "");
      }),
    );
    movementFilterCounts.forEach((count) => {
      count.textContent = String(
        selected.get(count.dataset.movementFilterCount ?? "")?.size ?? 0,
      );
    });
    totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
    renderPage(1);
  }

  paginationLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const page = Number(link.dataset.paginationPage);
      if (page >= 1 && page <= totalPages && page !== currentPage) {
        renderPage(page);
        window.history.replaceState({}, "", link.href);
      }
    });
  });

  movementFilters.forEach((filter) => {
    filter.addEventListener("change", applyFilters);
  });

  movementFilterMenus.forEach((menu) => {
    const panel = menu.querySelector<HTMLElement>(":scope > div");
    const summary = menu.querySelector<HTMLElement>(":scope > summary");
    if (!panel || !summary) return;

    menu.addEventListener("toggle", () => {
      if (!menu.open) {
        panel.style.position = "";
        panel.style.top = "";
        panel.style.left = "";
        panel.style.right = "";
        return;
      }

      const bounds = summary.getBoundingClientRect();
      panel.style.position = "fixed";
      panel.style.top = `${bounds.bottom + 8}px`;
      panel.style.left = `${Math.max(8, bounds.left)}px`;
      panel.style.right = "auto";
    });
  });

  renderPage(currentPage);
</script>
