---
import Layout from '../layouts/Layout.astro';
import AccountSummaryTable from '../components/accounts/AccountSummaryTable.astro';
import DistributionChart from '../components/accounts/DistributionChart.astro';
import AccountCard from '../components/accounts/AccountCard.astro';
import RecentTransactions from '../components/accounts/RecentTransactions.astro';
import { dashboardService } from '../services/dashboard.service';
import { formatCurrencyCOP } from '../utils/format';

const [entitySummary, entitySummaryFooter, distributionFunds, accountCards, recentTransactions] = await Promise.all([
  dashboardService.getEntitySummary(),
  dashboardService.getEntitySummaryFooter(),
  dashboardService.getDistributionFunds(),
  dashboardService.getAccountCards(),
  dashboardService.getRecentTransactions(),
]);

const summaryEntities = entitySummary.map(entity => ({
  ...entity,
  contingency: entity.contingency ? formatCurrencyCOP(entity.contingency) : null,
  emergency: entity.emergency ? formatCurrencyCOP(entity.emergency) : null,
  investment: entity.investment ? formatCurrencyCOP(entity.investment) : null,
  retirement: entity.retirement ? formatCurrencyCOP(entity.retirement) : null,
  total: formatCurrencyCOP(entity.total),
}));

const formattedFooter = {
  ...entitySummaryFooter,
  contingency: formatCurrencyCOP(entitySummaryFooter.contingency),
  emergency: formatCurrencyCOP(entitySummaryFooter.emergency),
  investment: formatCurrencyCOP(entitySummaryFooter.investment),
  retirement: formatCurrencyCOP(entitySummaryFooter.retirement),
  total: formatCurrencyCOP(entitySummaryFooter.total),
};

const formattedDistributionFunds = distributionFunds.map(fund => ({
  ...fund,
  amount: formatCurrencyCOP(fund.amount),
}));

const formattedAccountCards = accountCards.map(card => ({
  ...card,
  balance: formatCurrencyCOP(card.balance),
}));

const formattedRecentTransactions = recentTransactions.map(txn => ({
  ...txn,
  amount: `+${formatCurrencyCOP(txn.amount)}`,
}));
---

<Layout title="Cuentas" activePage="accounts">
  <!-- Page Heading -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <h2 class="text-headline-lg font-headline-lg text-on-surface">Gestión de Cuentas</h2>
      <p class="text-body-md font-body-md text-on-surface-variant">Visión agregada de capital por entidad y tipo de fondo.</p>
    </div>
    <div class="flex gap-2">
      <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-body-md flex items-center shadow-sm hover:opacity-90 transition-opacity">
        <span class="material-symbols-outlined mr-2">add</span>
        Nueva Cuenta
      </button>
      <button class="border border-outline px-4 py-2 rounded-lg font-bold text-body-md flex items-center bg-surface hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined mr-2">download</span>
        Exportar
      </button>
    </div>
  </div>

  <!-- Bento Grid - Section 1: Distribution Table -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-gutter mb-stack-lg">
    <AccountSummaryTable entities={summaryEntities} footer={formattedFooter} />
    <DistributionChart title="Fondo de Retiro" percentage={56} funds={formattedDistributionFunds} />
  </section>

  <!-- Section 2: Account Cards -->
  <section class="space-y-stack-md mb-stack-lg">
    <div class="flex items-center justify-between">
      <h3 class="text-headline-md font-headline-md">Cartera de Activos</h3>
      <div class="flex items-center text-on-surface-variant gap-4">
        <span class="text-body-md">Ordernar por: <strong>Balance</strong></span>
        <div class="flex bg-surface-container rounded-lg p-1">
          <button class="p-1 bg-surface-container-highest rounded">
            <span class="material-symbols-outlined">grid_view</span>
          </button>
          <button class="p-1 hover:bg-surface-container-high transition-colors rounded">
            <span class="material-symbols-outlined">view_list</span>
          </button>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {formattedAccountCards.map((card) => (
        <AccountCard
          initial={card.initial}
          name={card.name}
          description={card.description}
          balance={card.balance}
          category={card.category}
          categoryColor={card.categoryColor}
          categoryId={card.categoryId}
          fundDots={card.fundDots}
          isActive={card.isActive}
        />
      ))}
      <!-- Add New Card Placeholder -->
      <div class="bg-surface-container-low border border-dashed border-outline-variant rounded-xl p-5 flex flex-col items-center justify-center text-center hover:bg-surface-container-high transition-colors cursor-pointer group">
        <div class="w-12 h-12 rounded-full border-2 border-dashed border-outline-variant flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-outline">add</span>
        </div>
        <p class="text-body-md font-bold text-on-surface-variant">Vincular Nueva Cuenta</p>
        <p class="text-label-caps text-on-surface-variant opacity-70">Soporta API & Manual</p>
      </div>
    </div>
  </section>

  <!-- Bottom Section: Transactions History Snapshot -->
  <RecentTransactions transactions={formattedRecentTransactions} />

  <!-- Sticky Footer Summary for Mobile View -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 bg-surface-container-lowest border-t border-outline-variant p-4 z-50 flex justify-between items-center">
    <div>
      <p class="text-label-caps text-on-surface-variant">TOTAL PATRIMONIO</p>
      <p class="text-data-display font-data-display">{formatCurrencyCOP(entitySummaryFooter.total)}</p>
    </div>
    <button class="bg-primary text-on-primary w-12 h-12 rounded-full shadow-lg flex items-center justify-center">
      <span class="material-symbols-outlined">add</span>
    </button>
  </div>
</Layout>

<style>
  .account-card-active {
    border-left: 3px solid black;
  }
</style>
