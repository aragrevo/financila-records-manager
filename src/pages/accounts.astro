---
import Layout from '../layouts/Layout.astro';
import AccountSummaryTable from '../components/accounts/AccountSummaryTable.astro';
import DistributionChart from '../components/accounts/DistributionChart.astro';
import AccountCard from '../components/accounts/AccountCard.astro';
import RecentTransactions from '../components/accounts/RecentTransactions.astro';
import { dashboardService } from '../services/dashboard.service';
import { formatCurrencyCOP } from '../utils/format';

const [entitySummary, entitySummaryFooter, distributionFunds, accountCards, recentTransactions] = await Promise.all([
  dashboardService.getEntitySummary(),
  dashboardService.getEntitySummaryFooter(),
  dashboardService.getDistributionFunds(),
  dashboardService.getAccountCards(),
  dashboardService.getRecentTransactions(),
]);

const summaryEntities = entitySummary.map(entity => ({
  ...entity,
  contingency: entity.contingency ? formatCurrencyCOP(entity.contingency) : null,
  emergency: entity.emergency ? formatCurrencyCOP(entity.emergency) : null,
  investment: entity.investment ? formatCurrencyCOP(entity.investment) : null,
  retirement: entity.retirement ? formatCurrencyCOP(entity.retirement) : null,
  total: formatCurrencyCOP(entity.total),
}));

const formattedFooter = {
  ...entitySummaryFooter,
  contingency: formatCurrencyCOP(entitySummaryFooter.contingency),
  emergency: formatCurrencyCOP(entitySummaryFooter.emergency),
  investment: formatCurrencyCOP(entitySummaryFooter.investment),
  retirement: formatCurrencyCOP(entitySummaryFooter.retirement),
  total: formatCurrencyCOP(entitySummaryFooter.total),
};

const formattedDistributionFunds = distributionFunds.map(fund => ({
  ...fund,
  amount: formatCurrencyCOP(fund.amount),
}));

const formattedAccountCards = accountCards.map(card => ({
  ...card,
  balance: formatCurrencyCOP(card.balance),
}));

const formattedRecentTransactions = recentTransactions.map(txn => ({
  ...txn,
  amount: `+${formatCurrencyCOP(txn.amount)}`,
}));
---

<Layout title="Cuentas" activePage="accounts">
  <!-- Page Heading -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <h2 class="text-headline-lg font-headline-lg text-on-surface">Gestión de Cuentas</h2>
      <p class="text-body-md font-body-md text-on-surface-variant">Visión agregada de capital por entidad y tipo de fondo.</p>
    </div>
    <div class="flex gap-2">
      <button id="btn-new-account" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-body-md flex items-center shadow-sm hover:opacity-90 transition-opacity">
        <span class="material-symbols-outlined mr-2">add</span>
        Nueva Cuenta
      </button>
      <button class="border border-outline px-4 py-2 rounded-lg font-bold text-body-md flex items-center bg-surface hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined mr-2">download</span>
        Exportar
      </button>
    </div>
  </div>

  <!-- Bento Grid - Section 1: Distribution Table -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-gutter mb-stack-lg">
    <AccountSummaryTable entities={summaryEntities} footer={formattedFooter} />
    <DistributionChart title="Fondo de Retiro" percentage={56} funds={formattedDistributionFunds} />
  </section>

  <!-- Section 2: Account Cards -->
  <section class="space-y-stack-md mb-stack-lg">
    <div class="flex items-center justify-between">
      <h3 class="text-headline-md font-headline-md">Cartera de Activos</h3>
      <div class="flex items-center text-on-surface-variant gap-4">
        <span class="text-body-md">Ordernar por: <strong>Balance</strong></span>
        <div class="flex bg-surface-container rounded-lg p-1">
          <button class="p-1 bg-surface-container-highest rounded">
            <span class="material-symbols-outlined">grid_view</span>
          </button>
          <button class="p-1 hover:bg-surface-container-high transition-colors rounded">
            <span class="material-symbols-outlined">view_list</span>
          </button>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {formattedAccountCards.map((card) => (
        <AccountCard
          initial={card.initial}
          name={card.name}
          description={card.description}
          balance={card.balance}
          category={card.category}
          categoryColor={card.categoryColor}
          categoryId={card.categoryId}
          fundDots={card.fundDots}
          isActive={card.isActive}
        />
      ))}
      <!-- Add New Card Placeholder -->
      <div id="btn-new-account-card" class="bg-surface-container-low border border-dashed border-outline-variant rounded-xl p-5 flex flex-col items-center justify-center text-center hover:bg-surface-container-high transition-colors cursor-pointer group">
        <div class="w-12 h-12 rounded-full border-2 border-dashed border-outline-variant flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-outline">add</span>
        </div>
        <p class="text-body-md font-bold text-on-surface-variant">Vincular Nueva Cuenta</p>
        <p class="text-label-caps text-on-surface-variant opacity-70">Soporta API & Manual</p>
      </div>
    </div>
  </section>

  <!-- Bottom Section: Transactions History Snapshot -->
  <RecentTransactions transactions={formattedRecentTransactions} />

  <!-- Sticky Footer Summary for Mobile View -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 bg-surface-container-lowest border-t border-outline-variant p-4 z-50 flex justify-between items-center">
    <div>
      <p class="text-label-caps text-on-surface-variant">TOTAL PATRIMONIO</p>
      <p class="text-data-display font-data-display">{formatCurrencyCOP(entitySummaryFooter.total)}</p>
    </div>
    <button class="bg-primary text-on-primary w-12 h-12 rounded-full shadow-lg flex items-center justify-center">
      <span class="material-symbols-outlined">add</span>
    </button>
  </div>

  <!-- Create Account Modal -->
  <div id="create-account-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
    <div class="bg-surface rounded-xl shadow-xl w-full max-w-md">
      <div class="flex items-center justify-between p-6 border-b border-outline-variant">
        <h3 class="text-headline-md font-headline-md text-on-surface">Nueva Cuenta</h3>
        <button id="modal-close" class="text-on-surface-variant hover:text-on-surface">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <form id="create-account-form" class="p-6 space-y-4">
        <div>
          <label for="account-name" class="block text-label-md text-on-surface-variant mb-1">Nombre</label>
          <input type="text" id="account-name" name="name" required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            placeholder="Ej: Cuenta de Ahorros" />
        </div>
        <div>
          <label for="account-type" class="block text-label-md text-on-surface-variant mb-1">Tipo</label>
          <select id="account-type" name="type" required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary">
            <option value="checking">Corriente</option>
            <option value="savings">Ahorros</option>
            <option value="investment">Inversión</option>
            <option value="credit">Crédito</option>
          </select>
        </div>
        <div>
          <label for="account-institution" class="block text-label-md text-on-surface-variant mb-1">Institución</label>
          <input type="text" id="account-institution" name="institution" required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            placeholder="Ej: Banco Nacional" />
        </div>
        <div>
          <label for="account-balance" class="block text-label-md text-on-surface-variant mb-1">Balance Inicial</label>
          <input type="number" id="account-balance" name="balance" step="0.01" required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary"
            placeholder="0.00" />
        </div>
        <div>
          <label for="account-category" class="block text-label-md text-on-surface-variant mb-1">Categoría</label>
          <select id="account-category" name="category" required
            class="w-full px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary">
            <option value="contingency">Contingencia</option>
            <option value="emergency">Emergencia</option>
            <option value="investment">Inversión</option>
            <option value="retirement">Retiro</option>
          </select>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="modal-cancel" class="flex-1 px-4 py-2 border border-outline-variant rounded-lg font-bold text-body-md text-on-surface hover:bg-surface-container transition-colors">
            Cancelar
          </button>
          <button type="submit" class="flex-1 px-4 py-2 bg-primary text-on-primary rounded-lg font-bold text-body-md hover:opacity-90 transition-opacity">
            Crear Cuenta
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .account-card-active {
    border-left: 3px solid black;
  }
</style>

<script>
  const modal = document.getElementById('create-account-modal');
  const btnNew = document.getElementById('btn-new-account');
  const btnCard = document.getElementById('btn-new-account-card');
  const btnClose = document.getElementById('modal-close');
  const btnCancel = document.getElementById('modal-cancel');
  const form = document.getElementById('create-account-form') as HTMLFormElement;

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    form?.reset();
  }

  btnNew?.addEventListener('click', openModal);
  btnCard?.addEventListener('click', openModal);
  btnClose?.addEventListener('click', closeModal);
  btnCancel?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      type: formData.get('type'),
      institution: formData.get('institution'),
      balance: parseFloat(formData.get('balance') as string),
      category: formData.get('category'),
    };

    try {
      const res = await fetch('/api/accounts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        closeModal();
        window.location.reload();
      } else {
        alert('Error al crear la cuenta');
      }
    } catch {
      alert('Error de conexión');
    }
  });
</script>
