---
import Layout from "../layouts/Layout.astro";
import { STOCK_ASSET_TYPES, STOCK_BROKERS } from "../lib/constants";
import { stocksService } from "../services/stocks.service";
import BrokerOverview from "../components/wealth/BrokerOverview.astro";
import PortfolioInsights from "../components/wealth/PortfolioInsights.astro";
import PortfolioSummaryCards from "../components/wealth/PortfolioSummaryCards.astro";
import StockManagementModals from "../components/wealth/StockManagementModals.astro";
import StockPositionsTable from "../components/wealth/StockPositionsTable.astro";
import AiInsights from "../components/dashboard/AiInsights.astro";
import type {
  AccountMetric,
  AssetTypeSummaryItem,
  AssetChipVariant,
  BrokerChipVariant,
  BrokerSummaryItem,
  HoldingWithContext,
  RepeatedTickerSummaryItem,
  SummaryMetrics,
} from "../components/wealth/types";

const brokerVariant: Record<keyof typeof STOCK_BROKERS, BrokerChipVariant> = {
  xtb: "contingency",
  hapi: "investment",
  tyba: "retirement",
};

const assetVariant: Record<keyof typeof STOCK_ASSET_TYPES, AssetChipVariant> = {
  stock: "contingency",
  etf: "investment",
  reit: "emergency",
  adr: "retirement",
};

const priceSyncSummary = await stocksService.syncActivePositionPrices();
const [stockAccounts, stockPositions] = await Promise.all([
  stocksService.getAccounts(),
  stocksService.getPositions(),
]);
const activeStockPositions = stockPositions.filter((position) => position.status === "active");
const closedStockPositions = stockPositions
  .filter((position) => position.status === "closed")
  .sort((left, right) => {
    const leftTime = left.closedAt ? new Date(left.closedAt).getTime() : 0;
    const rightTime = right.closedAt ? new Date(right.closedAt).getTime() : 0;
    return rightTime - leftTime;
  });

const accountMetrics: AccountMetric[] = stockAccounts.map((account) => {
  const positions = activeStockPositions.filter((position) => position.accountId === account.id);
  const investedCapital = positions.reduce(
    (sum, position) => sum + position.shares * position.averageCost,
    0,
  );
  const marketValue = positions.reduce(
    (sum, position) => sum + position.shares * position.currentPrice,
    0,
  );

  return {
    ...account,
    positionsCount: positions.length,
    investedCapital,
    marketValue,
    totalValue: marketValue + account.availableCash,
    unrealizedGain: marketValue - investedCapital,
  };
});

const investedCapital = accountMetrics.reduce((sum, account) => sum + account.investedCapital, 0);
const marketValue = accountMetrics.reduce((sum, account) => sum + account.marketValue, 0);
const availableCash = stockAccounts.reduce((sum, account) => sum + account.availableCash, 0);

const summaryMetrics: SummaryMetrics = {
  portfolioValue: marketValue + availableCash,
  investedCapital,
  unrealizedGain: marketValue - investedCapital,
  performance: investedCapital > 0 ? ((marketValue - investedCapital) / investedCapital) * 100 : 0,
  totalMonthlyContribution: stockAccounts.reduce(
    (sum, account) => sum + account.monthlyContribution,
    0,
  ),
};

const priceSyncMessage =
  priceSyncSummary.failedSymbols.length === 0
    ? ""
    : priceSyncSummary.updatedPositions === 0
      ? "No se pudieron refrescar las cotizaciones de Yahoo. Se mantienen los ultimos precios guardados."
      : `${priceSyncSummary.failedSymbols.length} ticker${
          priceSyncSummary.failedSymbols.length === 1 ? "" : "s"
        } conservaron su ultimo precio por falta de cotizacion.`;

const holdingsWithContext: HoldingWithContext[] = activeStockPositions
  .map((position) => {
    const account = stockAccounts.find((item) => item.id === position.accountId);
    const currentValue = position.shares * position.currentPrice;
    const costBasis = position.shares * position.averageCost;

    return {
      ...position,
      accountName: account?.name ?? "Cuenta eliminada",
      broker: account?.broker ?? "xtb",
      currentValue,
      costBasis,
      gain: currentValue - costBasis,
      weight: marketValue > 0 ? (currentValue / marketValue) * 100 : 0,
    };
  })
  .sort((left, right) => right.currentValue - left.currentValue);

const repeatedTickers: RepeatedTickerSummaryItem[] = Object.values(
  holdingsWithContext.reduce<Record<string, HoldingWithContext[]>>((summary, holding) => {
    if (!summary[holding.symbol]) {
      summary[holding.symbol] = [];
    }

    summary[holding.symbol].push(holding);
    return summary;
  }, {}),
)
  .map((holdings) => {
    const accountsCount = new Set(holdings.map((holding) => holding.accountId)).size;
    if (accountsCount < 2) {
      return null;
    }

    const marketValue = holdings.reduce((sum, holding) => sum + holding.currentValue, 0);
    const brokers = [...new Set(holdings.map((holding) => holding.broker))];

    return {
      symbol: holdings[0]?.symbol ?? "",
      name: holdings[0]?.name ?? "",
      accountsCount,
      brokers,
      positionsCount: holdings.length,
      marketValue,
      percentage: 0,
    };
  })
  .filter((ticker): ticker is RepeatedTickerSummaryItem => Boolean(ticker));

const totalRepeatedTickersValue = repeatedTickers.reduce((sum, ticker) => sum + ticker.marketValue, 0);

const repeatedTickersChart = repeatedTickers
  .map((ticker) => ({
    ...ticker,
    percentage: totalRepeatedTickersValue > 0 ? (ticker.marketValue / totalRepeatedTickersValue) * 100 : 0,
  }))
  .sort((left, right) => right.marketValue - left.marketValue);

const closedHoldingsWithContext: HoldingWithContext[] = closedStockPositions
  .map((position) => {
    const account = stockAccounts.find((item) => item.id === position.accountId);
    const currentValue = position.shares * position.currentPrice;
    const costBasis = position.shares * position.averageCost;

    return {
      ...position,
      accountName: account?.name ?? "Cuenta eliminada",
      broker: account?.broker ?? "xtb",
      currentValue,
      costBasis,
      gain: currentValue - costBasis,
      weight: 0,
    };
  });

const brokerSummary: BrokerSummaryItem[] = Object.values(
  accountMetrics.reduce<Record<keyof typeof STOCK_BROKERS, BrokerSummaryItem>>(
    (summary, account) => {
      const broker = account.broker;

      summary[broker].accounts += 1;
      summary[broker].positions += account.positionsCount;
      summary[broker].investedCapital += account.investedCapital;
      summary[broker].marketValue += account.marketValue;
      summary[broker].availableCash += account.availableCash;
      summary[broker].gain += account.unrealizedGain;

      return summary;
    },
    {
      xtb: {
        broker: "xtb",
        accounts: 0,
        positions: 0,
        investedCapital: 0,
        marketValue: 0,
        availableCash: 0,
        gain: 0,
      },
      hapi: {
        broker: "hapi",
        accounts: 0,
        positions: 0,
        investedCapital: 0,
        marketValue: 0,
        availableCash: 0,
        gain: 0,
      },
      tyba: {
        broker: "tyba",
        accounts: 0,
        positions: 0,
        investedCapital: 0,
        marketValue: 0,
        availableCash: 0,
        gain: 0,
      },
    },
  ),
).filter((broker) => broker.accounts > 0 || broker.positions > 0);

const assetTypeSummary: AssetTypeSummaryItem[] = Object.values(
  holdingsWithContext.reduce<Record<string, AssetTypeSummaryItem>>((summary, holding) => {
    const assetType = holding.assetType;
    if (!summary[assetType]) {
      summary[assetType] = {
        assetType,
        label: STOCK_ASSET_TYPES[assetType],
        value: 0,
        percentage: 0,
        color: assetVariant[assetType],
      };
    }

    summary[assetType].value += holding.currentValue;
    return summary;
  }, {}),
)
  .map((item) => ({
    ...item,
    percentage: marketValue > 0 ? (item.value / marketValue) * 100 : 0,
  }))
  .sort((left, right) => right.value - left.value);
---

<Layout title="Acciones" activePage="wealth">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-headline-lg font-bold text-on-surface">Gestión de Acciones</h1>
        <p class="mt-1 text-body-md text-on-surface-variant">
          Registra brokers, cuentas y posiciones reales para consolidar tu portafolio.
        </p>
        {priceSyncMessage ? (
          <p class="mt-2 text-body-sm text-on-surface-variant">
            {priceSyncMessage}
          </p>
        ) : null}
      </div>
      <div class="flex flex-wrap gap-3">
        <button
          id="btn-new-stock-account"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-outline-variant text-on-surface transition-colors hover:bg-surface-container"
          title="Nueva cuenta"
          aria-label="Nueva cuenta"
        >
          <span class="material-symbols-outlined">account_balance</span>
        </button>
        <button
          id="btn-new-stock-position"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary text-on-primary transition-opacity hover:opacity-90"
          title="Nueva posición"
          aria-label="Nueva posición"
        >
          <span class="material-symbols-outlined">add</span>
        </button>
      </div>
    </div>

    <PortfolioSummaryCards metrics={summaryMetrics} />

    <AiInsights
      endpoint="/api/ai/portfolio-insights"
      title="Análisis IA del Portafolio"
      icon="monitoring"
    />

    <BrokerOverview
      brokerSummary={brokerSummary}
      portfolioValue={summaryMetrics.portfolioValue}
      accountsCount={stockAccounts.length}
      positionsCount={activeStockPositions.length}
      assetTypesCount={assetTypeSummary.length}
      brokerVariant={brokerVariant}
    />

    <StockPositionsTable
      holdings={holdingsWithContext}
      closedHoldings={closedHoldingsWithContext}
      brokerVariant={brokerVariant}
      assetVariant={assetVariant}
      failedPriceSymbols={priceSyncSummary.failedSymbols}
    />

    <PortfolioInsights
      assetTypeSummary={assetTypeSummary}
      repeatedTickers={repeatedTickersChart}
      brokerVariant={brokerVariant}
    />
  </div>

  <StockManagementModals stockAccounts={stockAccounts} />
</Layout>
