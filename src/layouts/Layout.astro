---
interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Financial Records Manager - Personal Finance Management" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title} | Financial Records Manager</title>
  </head>
  <body class="min-h-screen bg-surface">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-outline-variant flex flex-col">
        <!-- Logo -->
        <div class="p-6 border-b border-outline-variant">
          <h1 class="text-headline-md font-bold text-primary">Financial Records</h1>
          <p class="text-body-md text-on-surface-variant mt-1">Manager</p>
        </div>
        
        <!-- Navigation -->
        <nav class="flex-1 p-4 space-y-1">
          <a
            href="/"
            class:list={[
              'flex items-center px-4 py-3 rounded-lg text-sm font-medium transition-colors',
              activePage === 'dashboard'
                ? 'bg-primary text-on-primary'
                : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface',
            ]}
          >
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            Dashboard
          </a>
          
          <a
            href="/accounts"
            class:list={[
              'flex items-center px-4 py-3 rounded-lg text-sm font-medium transition-colors',
              activePage === 'accounts'
                ? 'bg-primary text-on-primary'
                : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface',
            ]}
          >
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            Accounts
          </a>
          
          <a
            href="/history"
            class:list={[
              'flex items-center px-4 py-3 rounded-lg text-sm font-medium transition-colors',
              activePage === 'history'
                ? 'bg-primary text-on-primary'
                : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface',
            ]}
          >
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            History
          </a>
          
          <a
            href="/wealth"
            class:list={[
              'flex items-center px-4 py-3 rounded-lg text-sm font-medium transition-colors',
              activePage === 'wealth'
                ? 'bg-primary text-on-primary'
                : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface',
            ]}
          >
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            Wealth Management
          </a>
        </nav>
        
        <!-- User section -->
        <div class="p-4 border-t border-outline-variant">
          <div class="flex items-center">
            <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center">
              <span class="text-on-primary text-sm font-medium">JD</span>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-on-surface">John Doe</p>
              <p class="text-xs text-on-surface-variant">Personal Account</p>
            </div>
          </div>
        </div>
      </aside>
      
      <!-- Main content -->
      <main class="flex-1 overflow-auto">
        <div class="max-w-container mx-auto p-gutter">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
